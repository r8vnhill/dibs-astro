{
    "name": "dibs-astro",
    "type": "module",
    "version": "0.22.0",
    "license": "BSD-2-Clause",
    "engines": {
        "node": ">=24 <27"
    },
    "packageManager": "pnpm@11.8.0",
    "scripts": {
        "i18n:compile": "node ./node_modules/@inlang/paraglide-js/bin/run.js compile --project ./project.inlang --outdir ./src/generated/i18n --emit-ts-declarations",
        "check:architecture": "node scripts/check-architecture.mjs",
        "check:toolchain": "node scripts/check-toolchain.mjs",
        "check:published-package-resolution": "node scripts/check-published-package-resolution.mjs",
        "build:content-core": "node scripts/run-workspace-script.mjs packages/content-core build",
        "build:lesson-export-core": "node scripts/run-workspace-script.mjs packages/lesson-export-core build",
        "build:shiki-core": "node scripts/run-workspace-script.mjs packages/shiki-core build",
        "export:pdf": "node scripts/export-lessons-pdf.mjs",
        "export:pdf:all": "node scripts/export-lessons-pdf.mjs --all",
        "export:pdf:smoke": "node scripts/export-lessons-pdf.mjs --route /notes/software-libraries/artifacts-taxonomy/",
        "export:pdf:dry-run": "node scripts/export-lessons-pdf.mjs --all --dry-run",
        "check:content-core": "pnpm --dir=packages/content-core run check && pnpm run test:typecheck:content-core",
        "check:lesson-export-core": "pnpm --filter @ravenhill/lesson-export-core check",
        "check:shiki-core": "pnpm --dir=packages/shiki-core run check",
        "generate:bibliography-catalog": "node scripts/build-bibliography-catalog.mjs",
        "generate:lesson-metadata": "node scripts/generate-lesson-metadata.mjs",
        "generate:platform-artifact-manifest": "node scripts/generate-platform-artifact-manifest.mjs --out tmp/platform-artifact-manifest.json",
        "fonts:generate": "node scripts/fonts/build-dibs-fonts.mjs",
        "fonts:check": "node scripts/fonts/build-dibs-fonts.mjs --check",
        "predev": "pnpm run i18n:compile && pnpm run build:content-core && pnpm run build:lesson-export-core && pnpm run build:shiki-core && pnpm run generate:bibliography-catalog && pnpm run generate:lesson-metadata",
        "dev": "node scripts/dev.mjs",
        "prebuild": "pnpm run i18n:compile && pnpm run build:content-core && pnpm run build:lesson-export-core && pnpm run build:shiki-core && pnpm run generate:bibliography-catalog && pnpm run generate:lesson-metadata",
        "build": "node ./node_modules/astro/bin/astro.mjs build",
        "preview": "node scripts/preview-dev.mjs",
        "astro": "astro",
        "fmt": "dprint fmt",
        "check": "pnpm run check:toolchain && pnpm run i18n:compile && pnpm run check:content-core && pnpm run check:lesson-export-core && pnpm run check:shiki-core && pnpm run generate:bibliography-catalog && node scripts/run-astro-check.mjs && node scripts/generate-lesson-metadata.mjs --dry-run --quiet && pnpm run check:architecture",
        "bibliography:report": "pnpm run generate:bibliography-catalog && node scripts/bibliography-report.mjs",
        "predeploy": "pnpm run build:content-core && pnpm run build:lesson-export-core && pnpm run build:shiki-core && pnpm run generate:bibliography-catalog && pnpm run generate:lesson-metadata",
        "deploy": "astro build && wrangler deploy",
        "test": "pnpm test:unit && pnpm test:astro",
        "test:unit": "vitest run",
        "test:pdf-smoke": "node scripts/test-pdf-export-smoke.mjs",
        "test:typecheck:content-core": "node ./node_modules/vitest/vitest.mjs list --typecheck.only --config vitest.content-core.types.config.ts && pnpm --dir=packages/content-core exec tsc --noEmit --pretty false",
        "test:astro": "node ./node_modules/vitest/vitest.mjs run --config vitest.astro.config.ts",
        "test:container": "node scripts/test-container.mjs",
        "playwright:install": "pnpm exec playwright install chromium",
        "test:e2e": "playwright test",
        "test:watch": "vitest --watch",
        "test:watch:astro": "node ./node_modules/vitest/vitest.mjs --watch --config vitest.astro.config.ts",
        "test:ui": "vitest --ui"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/markdoc": "^2.0.6",
        "@inlang/paraglide-js": "2.23.2",
        "@lucide/astro": "^0.536.0",
        "@ravenhill/astro-icons": "0.2.0",
        "@ravenhill/astro-head": "file:./vendor/astro-head",
        "@ravenhill/astro-site-chrome": "file:./vendor/astro-site-chrome",
        "@ravenhill/astro-site-shell": "file:./vendor/astro-site-shell",
        "@ravenhill/content-core": "workspace:*",
        "@ravenhill/lesson-export-core": "workspace:*",
        "@ravenhill/shiki-core": "workspace:*",
        "@ravenhill/site-core": "0.1.0",
        "@tabler/icons": "^3.34.1",
        "@tailwindcss/forms": "^0.5.10",
        "@types/hast": "^3.0.4",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "astro": "7.2.2",
        "astro-expressive-code": "^0.44.1",
        "clsx": "^2.1.1",
        "jsonld": "^9.0.0",
        "lucide-react": "^0.536.0",
        "n3": "^2.0.3",
        "rehype": "^13.0.2",
        "tailwind-variants": "^2.1.0",
        "tw-animate-css": "^1.3.6",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@astrojs/react": "^6.0.2",
        "@inlang/plugin-message-format": "4.3.0",
        "@playwright/test": "1.62.1",
        "@shikijs/colorized-brackets": "^4.4.3",
        "@shikijs/transformers": "^4.4.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^30.0.0",
        "@typescript/typescript6": "^6.0.2",
        "beautiful-mermaid": "1.1.3",
        "cheerio": "^1.2.0",
        "dprint": "^0.48.0",
        "es-module-lexer": "^2.0.0",
        "fast-check": "^4.5.3",
        "fast-glob": "^3.3.3",
        "get-tsconfig": "^4.14.0",
        "globby": "^16.2.0",
        "html-validate": "11.6.2",
        "jsdom": "^25.0.0",
        "lint-staged": "^15.2.10",
        "picomatch": "^4.0.4",
        "playwright": "1.62.1",
        "prettier": "^3.6.2",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-classnames": "^0.8.2",
        "prettier-plugin-merge": "^0.8.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "publint": "^0.3.19",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "shiki": "^4.4.3",
        "shiki-transformer-color-highlight": "^1.1.0",
        "shiki-transformer-copy-button": "^0.0.5",
        "smol-toml": "^1.8.0",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "wrangler": "^4.123.0"
    },
    "lint-staged": {
        "*": [
            "pnpm dprint fmt --"
        ]
    }
}
