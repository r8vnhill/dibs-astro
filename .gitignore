# DIBS Astro website
# ==================
#
# Ignore generated output, dependency state, local tooling state, operating-system metadata, and contributor-local
# files that must not become part of the repository.
#
# Keep this file repository-specific. Before adding a new rule, prefer the narrowest pattern that describes the
# generated or local artifact, and verify it with:
#
#     git check-ignore -v <path>
#
# Do not ignore files merely because they differ between contributors. Configuration required for a reproducible
# checkout should normally be committed.

# Astro
# -----

# `astro build` writes the deployable site to `dist/`.
dist/

# Astro generates framework and content-layer state under `.astro/`, including TypeScript declarations used for editor
# and build-time type inference. Contributors should regenerate these files through Astro rather than commit them.
.astro/

# Node.js and pnpm
# ----------------

# Dependencies are reconstructed from `package.json` and the committed `pnpm-lock.yaml`.
node_modules/

# pnpm diagnostic output and a project-local store, if one is created by local tooling.
.pnpm-debug.log*
.pnpm-store/

# This repository uses pnpm exclusively. Ignore lockfiles produced accidentally by other package managers; the
# canonical dependency lockfile is `pnpm-lock.yaml` and must remain tracked.
package-lock.json
yarn.lock

# Logs and test output
# --------------------

logs/
*.log

# Coverage output is generated by the test tooling and must not be committed.
coverage/
.nyc_output/

# Tool caches
# -----------

# These directories contain disposable local state. They may be removed and regenerated without changing repository
# semantics.
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_*/
.webpack/
.vscode-test/
.yarn-integrity

# Explicit font generation caches the pinned upstream archive and disposable build trees here. The generated WOFF2
# deliverables under public/fonts/ are intentionally committed.
tmp/fonts/

# TypeScript
# ----------

# Incremental compiler metadata is machine-local build state.
*.tsbuildinfo

# Environment configuration
# -------------------------

# Local environment files may contain machine-specific configuration or credentials. Public examples such as
# `.env.example` should remain trackable and must not contain secrets.
.env
.env.local
.env.*.local

# Visual Studio Code
# ------------------

# Ignore contributor-local workspace state while keeping the repository-supported editor configuration.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

.history/
.ionide

# Cloudflare
# ----------

# Wrangler stores local development and deployment state here. Production configuration belongs in tracked project
# configuration rather than this generated directory.
.wrangler/

# Local GitLab Runner
# -------------------

# Root-level runner configuration is specific to a contributor's local runner. Anchor the rule at the repository root
# so a legitimate nested `config.toml` remains trackable.
#/config.toml
/config.toml

# Playwright
# ----------

# Browser-test artifacts are generated from the test suite and CI run. Keep durable fixtures and specifications under
# source control; ignore only their generated reports and execution output.
test-results/
playwright-report/
blob-report/

# Educational documentation
# -------------------------

# Exercise solution/submission artifacts are contributor- or evaluation-specific and are not canonical lesson source.
*.solucion.*
*.entregable.*

# Generated documentation PDFs are excluded from source control. If the project later needs authored PDF resources,
# narrow this pattern rather than adding exceptions ad hoc.
docs/**/*.pdf

# Operating-system metadata
# -------------------------

# These files are created by desktop/file-system tooling and have no repository semantics.

# macOS
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud

# Linux
*~
.directory
.Trash-*
.nfs*

# Windows
Thumbs.db
ehthumbs.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Contributor-local notes
# -----------------------

# Keep personal scratch notes out of the repository without ignoring similarly named files in lesson or documentation
# directories.
/todo.md
