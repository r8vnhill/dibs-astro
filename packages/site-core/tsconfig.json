{
    "extends": "astro/tsconfigs/strictest",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "rootDir": "src",
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
