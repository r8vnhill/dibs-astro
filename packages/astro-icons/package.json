{
    "name": "@ravenhill/astro-icons",
    "version": "0.1.0",
    "type": "module",
    "private": false,
    "description": "SVG icon assets for Ravenhill Astro projects.",
    "license": "BSD-2-Clause",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSES"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup && node scripts/copy-assets.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "publint --strict",
        "pack:check": "node scripts/assert-pack-files.mjs --pack",
        "pack:dry-run": "npm pack --dry-run",
        "generate-icons:check": "node ../../generate-icons-index.js --check --asset-type=icons",
        "verify:artifact-integrity": "node scripts/verify-artifact-integrity.mjs",
        "check": "pnpm run test:audit-icons && pnpm run test:licenses && pnpm run test:pack-files && pnpm run licenses:check && pnpm run generate-icons:check && pnpm run build && pnpm run typecheck && pnpm run pack:check && pnpm run verify:artifact-integrity && pnpm run lint",
        "audit-icons": "node scripts/audit-icons.mjs --check",
        "audit-icons:update": "node scripts/audit-icons.mjs --write",
        "test:audit-icons": "node --test scripts/test/icon-name.test.mjs scripts/test/icon-inventory.test.mjs scripts/test/audit-icons.test.mjs scripts/test/icon-inventory.contract.test.mjs scripts/test/release-policy.test.mjs scripts/test/publishable-plan.test.mjs scripts/test/generate-exports.test.mjs scripts/test/copy-assets.test.mjs",
        "test:licenses": "node --test scripts/test/license-metadata.test.mjs scripts/test/third-party-notices.test.mjs scripts/test/third-party-notices.contract.test.mjs",
        "test:pack-files": "node --test scripts/test/pack-contract.test.mjs scripts/test/assert-pack-files-cli.test.mjs scripts/test/artifact-integrity.test.mjs scripts/test/verify-artifact-integrity-cli.test.mjs",
        "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
        "licenses:update": "node scripts/generate-third-party-notices.mjs --write"
    },
    "devDependencies": {
        "es-module-lexer": "^2.0.0",
        "publint": "^0.3.19",
        "tsup": "^8.5.1",
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "@ravenhill:registry": "https://gitlab.com/api/v4/projects/71752456/packages/npm/",
        "access": "restricted"
    }
}
