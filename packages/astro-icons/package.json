{
    "name": "@ravenhill/astro-icons",
    "version": "0.1.0",
    "type": "module",
    "private": false,
    "description": "SVG icon assets for Ravenhill Astro projects.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup && node scripts/copy-assets.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "publint --strict",
        "pack:check": "node scripts/assert-pack-files.mjs --pack",
        "pack:dry-run": "npm pack --dry-run",
        "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run pack:check",
        "audit-icons": "node scripts/audit-icons.mjs --check",
        "audit-icons:update": "node scripts/audit-icons.mjs --write",
        "test:audit-icons": "node --test scripts/test/icon-name.test.mjs scripts/test/icon-inventory.test.mjs scripts/test/audit-icons.test.mjs scripts/test/icon-inventory.contract.test.mjs"
    },
    "devDependencies": {
        "publint": "^0.3.19",
        "tsup": "^8.5.1",
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "@ravenhill:registry": "https://gitlab.com/api/v4/projects/71752456/packages/npm/",
        "access": "restricted"
    }
}
