{
    "extends": "astro/tsconfigs/strictest",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "rootDir": ".",
        "noEmit": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
