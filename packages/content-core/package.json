{
    "name": "@ravenhill/content-core",
    "version": "0.2.0",
    "type": "module",
    "private": false,
    "description": "Content abstraction layer for reusable documentation and learning systems.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "check": "pnpm run build && tsc --noEmit && pnpm run check:ts6 && publint --strict && pnpm run pack:check && pnpm run consumer:check",
        "check:ts6": "tsc6 --noEmit",
        "consumer:check": "node scripts/validate-packed-consumer.mjs",
        "pack:check": "node scripts/assert-pack-files.mjs --pack",
        "pack:dry-run": "node scripts/assert-pack-files.mjs --pack"
    },
    "devDependencies": {
        "@typescript/typescript6": "^6.0.2",
        "publint": "^0.3.19",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    },
    "publishConfig": {
        "@ravenhill:registry": "https://gitlab.com/api/v4/projects/71752456/packages/npm/",
        "access": "restricted"
    }
}
