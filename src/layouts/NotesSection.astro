---
import type { HTMLAttributes } from "astro/types";
import Heading from "~/components/semantics/Heading.astro";
import type { AstroComponentFactory } from "~/types/astro-component";
import type { HeadingLevel } from "~/utils";

type AsTag = "section" | "div" | "article";
type TagName = Exclude<HeadingLevel, "h1">;

type Props = {
    /** Element to render; defaults to 'section' for better semantics */
    as?: AsTag;
    /** If no heading slot is provided, use this for accessible name */
    ariaLabel?: string;
    /** Apply a conventional container layout (max-w & padding) */
    container?: boolean;
    /** Plain-text heading. Ignored when the `heading` slot is provided. */
    title?: string;
    /** Optional icon forwarded to the internally rendered heading. */
    Icon?: AstroComponentFactory | null;
    /** Heading tag rendered for `title`. Defaults to 'h2', the ordinary section level. */
    headingLevel?: TagName;
} & HTMLAttributes<"section">;

const {
    as = "section",
    id,
    ariaLabel,
    container = false,
    title,
    Icon = null,
    headingLevel = "h2",
    class: className,
    ...rest
} = Astro.props as Props;

const resolvedId = id ?? `notes-section-${crypto.randomUUID()}`;
const headingId = `${resolvedId}-heading`;
const hasHeadingSlot = Astro.slots.has("heading");

/** The `heading` slot is the escape hatch for rich headings. We can't "detect" if it's filled ahead
 * of time, so by convention its root element must set id={headingId} for aria-labelledby to resolve.
 * Example:
 *   <Heading id={headingId} ...>Title</Heading>
 * The `title` prop path below sets this id automatically.
 */
const Tag = as;
---

<Tag
    id={resolvedId} aria-label={ariaLabel}
    aria-labelledby={ariaLabel ? undefined : headingId} data-lesson-section
    class:list={[
        container && "mx-auto max-w-3xl px-4 sm:px-6 lg:px-8",
        className,
    ]}
    {...rest}
>
    {hasHeadingSlot && <slot name="heading" />}
    {
        !hasHeadingSlot && title && (
            <Heading
                id={headingId} {headingLevel}
                {Icon}
            >
                {title}
            </Heading>
        )
    }
    <slot />
</Tag>
