---
/**
 * DIBS composition adapter over `@ravenhill/astro-site-shell`.
 *
 * DIBS retains metadata, localization, theme, PDF, styling, navigation, header, and footer policy. The external
 * package owns only the generic document structure and skip-link/main-landmark relationship.
 */
import { getWebsiteRepoRef } from "$presentation/adapters/site-data";
import { DEFAULT_LOCALE_PROFILE } from "$presentation/i18n/locale-profile";
import { SiteShell, type SiteShellProps, type SkipLinkOptions } from "@ravenhill/astro-site-shell";
import Footer from "~/components/Footer.astro";
import Header from "~/components/header/Header.astro";
import Head from "~/components/meta/Head.astro";
import { m } from "~/generated/i18n/messages";
import "~/styles/global.css";
import { site } from "~/utils";
import type { PageMeta } from "~/utils/page-meta";

type Props = {
    pageTitle: string;
    description?: string;
    pageMeta?: PageMeta;
    lang?: string;
};

const { pageTitle, description, pageMeta, lang } = Astro.props as Props;

const githubRef = getWebsiteRepoRef("github");
const gitlabRef = getWebsiteRepoRef("gitlab");

const githubRepoInfo = githubRef
    ? {
        username: githubRef.user,
        repo: githubRef.repo,
    }
    : undefined;

const gitlabRepoInfo = gitlabRef
    ? {
        username: gitlabRef.user,
        repo: gitlabRef.repo,
    }
    : undefined;

const fullTitle = `${pageTitle} | ${site.SHORT_TITLE}`;
const documentLang = (lang ?? pageMeta?.language ?? DEFAULT_LOCALE_PROFILE.htmlLanguage).trim()
    || DEFAULT_LOCALE_PROFILE.htmlLanguage;
const isPdfExport = Astro.locals.lessonRenderMode === "pdf";

const headProps = {
    title: fullTitle,
    url: Astro.url.href,
    ...(description !== undefined ? { description } : {}),
    ...(pageMeta !== undefined ? { pageMeta } : {}),
};

const headerProps = {
    title: site.SHORT_TITLE,
    ...(gitlabRepoInfo ? { gitlab: gitlabRepoInfo } : {}),
    ...(githubRepoInfo ? { github: githubRepoInfo } : {}),
};

const themeLabels = {
    current: m.theme_current(),
    change: m.theme_change(),
    light: m.theme_light(),
    dark: m.theme_dark(),
    auto: m.theme_auto(),
};

const bodyAttributes: SiteShellProps["bodyAttributes"] = {
    class: "min-h-screen bg-base-background text-base-text",
};

const mainAttributes: SiteShellProps["mainAttributes"] = {
    class: isPdfExport ? "w-full" : "w-full pt-(--lesson-header-offset)",
};

const skipLink: SkipLinkOptions = {
    label: "Saltar al contenido principal",
    attributes: {
        class:
            "sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 z-50 rounded bg-base-background px-3 py-2",
    },
};
---

<SiteShell
    lang={documentLang} mainId="main-content"
    {bodyAttributes} {mainAttributes}
    {skipLink}
>
    <!-- DIBS theme policy remains before metadata and styles to prevent FOUC. -->
    <script is:inline slot="head">
        (() => {
            const DARK = "dark";
            const AUTO = "auto";

            try {
                const theme = localStorage.getItem("theme");

                const prefersDark = typeof window.matchMedia === "function"
                    && window.matchMedia("(prefers-color-scheme: dark)").matches;

                const isDark = theme === DARK || (theme === AUTO && prefersDark);

                document.documentElement.classList.toggle(DARK, isDark);
            } catch {
                const prefersDark = typeof window.matchMedia === "function"
                    && window.matchMedia("(prefers-color-scheme: dark)").matches;

                document.documentElement.classList.toggle(DARK, prefersDark);
            }
        })();
    </script>

    <Head slot="head" {...headProps} />

    {
        isPdfExport && (
            <meta
                slot="head" name="robots"
                content="noindex, nofollow"
            />
        )
    }

    <meta
        slot="head" name="color-scheme"
        content="light dark"
    />

    <Header
        slot="header" {...headerProps}
        {themeLabels}
    />

    <slot />

    <Footer slot="footer" />
</SiteShell>
