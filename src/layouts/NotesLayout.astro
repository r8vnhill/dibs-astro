---
/**
 * @file NotesLayout.astro
 *
 * Page layout for lesson content under `src/pages/notes/**`.
 *
 * This layout composes the main “lesson” experience:
 *
 * - A persistent course sidebar (tree navigation) built from `courseStructure`.
 * - The lesson header, with recommended dedication inserted below the document title.
 * - Optional lesson metadata panels (authors, last modified, recent changes, repo links).
 * - A dedicated abstract callout rendered from the named `abstract` slot.
 * - The lesson body via the default `<slot />`.
 * - Previous/next navigation controls (manual overrides or auto-resolved).
 *
 * ## Data sources
 *
 * - **Sidebar lessons:** `courseStructure` (static course definition).
 * - **Auto navigation:** {@link resolveAutoNav} uses `courseStructure` and current pathname.
 * - **Lesson metadata:** {@link resolveLessonMetadata} resolves metadata through the presentation
 *   bridge, which composes an application service with the generated-dataset adapter.
 * - **Abstract content:** provided by the page through `slot="abstract"`, with a placeholder
 *   fallback when absent.
 *
 * ## Navigation precedence
 *
 * Previous/next links may be provided by the page frontmatter and/or derived from the course
 * structure. `previous` accepts either a single link or a list of links, which allows comparative
 * or branch-style lessons to point back to more than one relevant page. Resolution follows this
 * precedence:
 *
 * 1. Explicit `previous`/`next` props (frontmatter override)
 * 2. Auto navigation from {@link resolveAutoNav}
 * 3. Omit navigation button when neither is available
 *
 * Manual `previous` arrays replace the auto-resolved previous link entirely; they are not merged.
 *
 * Links are normalized by {@link normalizePreviousNavigation} and {@link normalizeNavigation} to
 * ensure consistent routing (e.g. trailing slashes and collapsed separators).
 *
 * ## Accessibility
 *
 * - Sidebar is wrapped in `<aside>` with an explicit `aria-label`.
 * - The abstract remains a semantic callout rendered before the lesson body.
 * - Prev/next controls are wrapped in `<nav>` with an `aria-label`.
 * - Multiple previous links are rendered as a vertical list of buttons on the left side of the
 *   navigation block.
 * - When there is no “previous” button, a hidden placeholder is used on wide screens to
 *   preserve alignment without adding noise to assistive technologies.
 */
import * as icons from "$icons";
import { getCourseNavigationTree } from "$presentation/adapters/course-navigation";
import { resolveLessonMetadata } from "$presentation/adapters/lesson-metadata-bridge";
import { resolveAutoNav } from "$presentation/adapters/navigation-bridge";
import {
    type NavigationLinkInput,
    normalizeNavigation,
    normalizePreviousNavigation,
} from "$presentation/adapters/navigation-normalization";
import type { RepoRef } from "@ravenhill/site-core";
import LessonSidebar from "~/components/navigation/LessonSidebar";
import NavigationButton from "~/components/navigation/NavigationButton.astro";
import LessonToc from "~/components/notes/LessonToc.astro";
import {
    DEFAULT_TIME_MULTIPLIER,
    estimateReadingTime,
    extractReadableText,
} from "~/components/reading-time/reading-time";
import ReadingTime from "~/components/reading-time/ReadingTime.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import LessonDocumentLayout from "~/layouts/LessonDocumentLayout.astro";
import type { LessonDocumentLayoutProps } from "~/layouts/LessonDocumentLayout.props";
import type { LessonRenderMode } from "~/lib/presentation/export-mode";
import type { PageMeta } from "~/utils/page-meta";

/**
 * Props passed to the layout.
 *
 * Lesson pages typically set these values from frontmatter. The layout intentionally keeps the
 * navigation payload small (`title` + `href`) so pages can override navigation without depending
 * on the full course-structure lesson shape.
 */
interface Props {
    /**
     * Title of the current lesson.
     *
     * Rendered as the `<h1>` and used as the page title within {@link BaseLayout}.
     */
    title: string;

    /**
     * Short lesson description for SEO and social previews.
     *
     * Forwarded to {@link BaseLayout}.
     */
    description?: string;

    /**
     * Optional next lesson navigation override.
     *
     * If omitted, the layout attempts to auto-resolve it from the course structure.
     */
    next?: NavigationLinkInput;

    /**
     * Optional previous lesson navigation override.
     *
     * When an array is provided, every entry is rendered as its own “previous” button in the
     * order received. If omitted, the layout attempts to auto-resolve a single previous lesson
     * from the course structure.
     */
    previous?: NavigationLinkInput | readonly NavigationLinkInput[];

    /**
     * Multiplier applied to the reading-time estimate.
     *
     * Useful to tune reading-time estimates for lessons that include code, exercises, or dense
     * theoretical sections.
     */
    timeMultiplier?: number;

    /**
     * Optional render mode forwarded to the document layout.
     */
    renderMode?: LessonRenderMode;

    /**
     * Legacy compatibility prop forwarded to the document layout.
     */
    exportMode?: boolean;

    /**
     * Optional repository information for the lesson.
     *
     * When provided, the layout renders repository links via {@link LessonRepoPanel}.
     */
    git?: RepoRef | readonly RepoRef[];
}

// Extract current page data and resolve metadata/navigation.
const { title, next, previous, timeMultiplier, git, description, renderMode, exportMode } = Astro.props as Props;
const pathname = Astro.locals.lessonRoute ?? Astro.url.pathname;
const courseNavigationTree = await getCourseNavigationTree();

// Metadata may be missing or invalid if the route is absent from the generated dataset or its
// trusted record conversion fails.
const lessonMetadataResult = await resolveLessonMetadata(pathname);
const lessonMetadata = lessonMetadataResult.kind === "found" ? lessonMetadataResult.metadata : undefined;
const lessonPageMeta = lessonMetadata
    ? {
        authors: lessonMetadata.authors.map((author) => ({
            name: author.name,
            ...(author.url ? { url: author.url } : {}),
        })),
        changes: lessonMetadata.changes,
        ...(lessonMetadata.lastModified
            ? { lastModified: lessonMetadata.lastModified }
            : {}),
    }
    : {};

const pageMeta: PageMeta = {
    type: "website",
    canonicalUrl: Astro.url.href,
    language: "es",
    ...lessonPageMeta,
};

const documentProps: LessonDocumentLayoutProps = {
    title,
    ...(lessonMetadata ? { metadata: lessonMetadata } : {}),
    ...(git ? { git } : {}),
    ...(renderMode !== undefined ? { renderMode } : {}),
    ...(exportMode !== undefined ? { exportMode } : {}),
};

// Attempt to auto-resolve previous/next from course structure.
const autoNav = await resolveAutoNav(pathname, courseNavigationTree);

// Allow manual override from frontmatter (if provided). Manual previous arrays intentionally
// replace the auto-resolved previous lesson instead of merging with it.
const hasManualNavigation = Object.hasOwn(Astro.props, "previous") || Object.hasOwn(Astro.props, "next");
const effectivePrevious = hasManualNavigation ? previous : autoNav.previous ?? undefined;
const effectiveNext = hasManualNavigation ? next : autoNav.next ?? undefined;

// Normalize hrefs for consistency (e.g. ensure trailing slashes). Previous links are normalized as
// a list because the template renders them as a left-side stack when more than one is provided.
const normalizedPreviousList = normalizePreviousNavigation(effectivePrevious);
const { normalizedNext } = normalizeNavigation(
    effectiveNext,
    Array.isArray(effectivePrevious) ? effectivePrevious[0] : effectivePrevious,
);

const hasAbstract = Astro.slots.has("abstract");
const abstractHtml = hasAbstract ? await Astro.slots.render("abstract") : "";
const bodyHtml = await Astro.slots.render("default");
const readingTime = estimateReadingTime(
    extractReadableText(`${title}\n${abstractHtml}\n${bodyHtml}`),
    { timeMultiplier: timeMultiplier ?? DEFAULT_TIME_MULTIPLIER },
);
---

<BaseLayout
    pageTitle={title} {...(description !== undefined ? { description } : {})}
    {pageMeta}
>
    <div class="lesson-reading-shell">
        <!-- Sidebar with course structure navigation -->
        <div class="hidden lg:contents" data-export-hidden="true">
            <LessonSidebar
                client:load lessons={courseNavigationTree}
                currentPath={pathname}
            />
        </div>

        <!-- Main content area -->
        <div class:list={["lesson-reading-column", "min-w-0", "w-full", "px-4", "py-8", "sm:px-6", "xl:px-8"]}>
            <details class="mb-6 rounded border border-base-border p-3 lg:hidden" data-export-hidden="true">
                <summary class="cursor-pointer font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                    Navegación del curso
                </summary>
                <div class="mt-3 max-h-[60vh] overflow-y-auto">
                    <LessonSidebar
                        client:load lessons={courseNavigationTree}
                        currentPath={pathname}
                    />
                </div>
            </details>
            {
                hasAbstract ? (
                    <LessonDocumentLayout {...documentProps}>
                        <div
                            slot="after-title" class="contents"
                            data-export-hidden="true"
                        >
                            <ReadingTime minutes={readingTime.minutes} />
                        </div>
                        <Fragment slot="abstract" set:html={abstractHtml} />
                        <Fragment set:html={bodyHtml} />
                    </LessonDocumentLayout>
                ) : (
                    <LessonDocumentLayout {...documentProps}>
                        <div
                            slot="after-title" class="contents"
                            data-export-hidden="true"
                        >
                            <ReadingTime minutes={readingTime.minutes} />
                        </div>
                        <Fragment set:html={bodyHtml} />
                    </LessonDocumentLayout>
                )
            }

            {
                (hasManualNavigation || normalizedNext || normalizedPreviousList.length > 0)
                    && (
                    <nav
                        aria-label="Siguiente o anterior lección" data-export-hidden="true"
                        class:list={[
                            "mt-12",
                            "flex",
                            "flex-col",
                            "sm:flex-row",
                            "justify-between",
                            "gap-4",
                            "border-t",
                            "border-base-border",
                            "pt-6",
                        ]}
                    >
                        {
                            normalizedPreviousList.length > 0 ? (
                                <div class:list={["flex", "flex-col", "gap-4"]}>
                                    {
                                        normalizedPreviousList.map((
                                            previousLink,
                                        ) => (
                                            <NavigationButton
                                                href={previousLink.href} label={previousLink.title}
                                                iconPosition="left"
                                            >
                                                <icons.ArrowLeft class="w-5 h-5" slot="icon" />
                                            </NavigationButton>
                                        ))
                                    }
                                </div>
                            ) : <div aria-hidden="true" class="hidden sm:block" />
                        }

                        {
                            normalizedNext && (
                                <NavigationButton
                                    href={normalizedNext.href} label={normalizedNext.title}
                                    iconPosition="right"
                                >
                                    <icons.ArrowRight class="w-5 h-5" slot="icon" />
                                </NavigationButton>
                            )
                        }
                    </nav>
                )
            }
        </div>
        <LessonToc />
    </div>
</BaseLayout>

<style is:global>
    .lesson-reading-shell {
        display: grid;
        min-width: 0;
        align-items: start;
    }

    @media (min-width: 1024px) {
        .lesson-reading-shell {
            grid-template-columns: var(--sidebar-course, 17rem) minmax(0, 1fr);
        }
    }

    @media (min-width: 1440px) {
        .lesson-reading-shell {
            grid-template-columns: var(--sidebar-course, 18rem) minmax(0, 1fr) var(--sidebar-page, 18rem);
        }
    }

    .lesson-toc {
        display: none;
    }

    @media (min-width: 1440px) {
        .lesson-toc {
            display: block;
        }

        /*
         * The three-column desktop shell gives the lesson enough room to breathe,
         * but a 72ch measure leaves a visibly narrow island in the middle of wide
         * screens. Widen only the desktop reading column; smaller viewports keep
         * the comfortable default measure and the sidebars remain unchanged.
         */
        #lesson-content {
            --content-reading: 84ch;
        }
    }

    #lesson-content {
        width: min(100%, var(--content-reading, 72ch));
        max-width: var(--content-reading, 72ch);
        margin-inline: auto;
        font-size: var(--content-font-size);
        line-height: var(--content-line-height);
    }

    #lesson-content > h1 {
        margin-top: 0;
        margin-bottom: 0.4em;
        color: var(--base-text-color);
    }

    #lesson-content > section,
    #lesson-content > div[data-export-role="body"] > section {
        margin-top: 3.5rem;
    }

    #lesson-content p + p {
        margin-top: 1.1rem;
    }

    #lesson-content :is(h2, h3, h4) {
        color: var(--base-text-color);
        scroll-margin-top: var(--lesson-header-offset, 5.5rem);
    }

    #lesson-content h2 {
        margin-top: 0;
        font-size: clamp(1.4rem, 2vw, 1.75rem);
    }

    #lesson-content :not(pre) > code {
        border-radius: 0.25rem;
        background: color-mix(in srgb, var(--color-primary) 10%, transparent);
        padding: 0.08em 0.28em;
    }
    /**
     * Sidebar tree styles.
     *
     * These are global because the sidebar is rendered as a nested tree and the layout is
     * responsible for the overall page chrome.
     *
     * If these styles grow further, consider moving them into the sidebar component (or a
     * dedicated stylesheet) to keep this layout focused on composition.
     */
    .lesson-tree ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .lesson-tree li {
        line-height: 1.35;
    }
</style>
