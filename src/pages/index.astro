---
import * as icons from "@ravenhill/astro-icons";
import { site } from "~/utils";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Editorial homepage for the public site root.
 *
 * The homepage describes DIBS as a course, in a fixed order: what it is, what you learn, the
 * reference architecture the site embodies, the technology stack behind that implementation, and
 * how to start. It intentionally does not describe the development status of the website itself —
 * repository links already live in the shared header, and unfinished site areas do not appear here
 * as advertised destinations.
 *
 * Content stays local to this page on purpose: it is a small, curated composition with no
 * demonstrated reuse elsewhere yet.
 */
type LearningPillar = {
    icon: keyof typeof icons;
    title: string;
    body: string;
};

type ArchitectureLayer = {
    icon: keyof typeof icons;
    name: string;
    role: string;
    core: boolean;
};

type TechStackItem = {
    icon: keyof typeof icons;
    name: string;
    role: string;
};

const title = site.SHORT_TITLE;
const description =
    "DIBS es un curso online de nivel universitario sobre diseño e implementación de bibliotecas de software.";

const learningPillars = [
    {
        icon: "PuzzlePiece",
        title: "Diseño modular y abstracción",
        body:
            "Separar responsabilidades y ocultar detalles de implementación para que un componente pueda cambiar sin arrastrar al resto del sistema.",
    },
    {
        icon: "PlugsConnected",
        title: "APIs y contratos explícitos",
        body:
            "Diseñar superficies públicas claras, versionadas y predecibles, pensadas para quienes las consumen y no solo para quien las escribe.",
    },
    {
        icon: "ArrowsClockwise",
        title: "Verificación, mantención y evolución",
        body:
            "Construir con pruebas, automatización y disciplina de versionado que permitan que una biblioteca siga siendo confiable a medida que cambia.",
    },
] as const satisfies readonly LearningPillar[];

const architectureLayers = [
    {
        icon: "Browsers",
        name: "Presentación",
        role:
            "Adapta datos ya resueltos para la interfaz; consume aplicación e infraestructura sin exponer sus detalles.",
        core: false,
    },
    {
        icon: "Gear",
        name: "Aplicación",
        role: "Orquesta casos de uso: coordina el dominio y los puertos que necesita, sin contener reglas de negocio.",
        core: false,
    },
    {
        icon: "Cube",
        name: "Dominio",
        role: "El núcleo conceptual: reglas de negocio puras, sin dependencias de frameworks ni de infraestructura.",
        core: true,
    },
    {
        icon: "HardDrives",
        name: "Infraestructura",
        role: "Implementa los contratos que el dominio y la aplicación declaran: acceso a datos, APIs externas, I/O.",
        core: false,
    },
] as const satisfies readonly ArchitectureLayer[];

const techStack = [
    {
        icon: "RocketLaunch",
        name: "Astro",
        role: "Framework del sitio: renderiza HTML estático por defecto e hidrata solo lo interactivo.",
    },
    {
        icon: "Palette",
        name: "Tailwind CSS",
        role: "Sistema de estilos utilitario para construir la interfaz de forma consistente.",
    },
    {
        icon: "MarkdownLogo",
        name: "Markdoc",
        role: "Formato de autoría de los apuntes: Markdown extendido con componentes propios.",
    },
    {
        icon: "Atom",
        name: "React Islands",
        role: "Componentes interactivos aislados, usados solo donde el sitio realmente los necesita.",
    },
    {
        icon: "Shapes",
        name: "Infraestructura de íconos local",
        role: "Un set de íconos propio, auditado y empaquetado como parte del mismo sitio.",
    },
] as const satisfies readonly TechStackItem[];

const sectionContainer = "mx-auto max-w-7xl px-6 sm:px-10 lg:px-12";
const sectionKicker = "text-sm font-semibold uppercase tracking-[0.14em] text-primary";
const sectionTitle = "mt-3 text-3xl font-semibold tracking-tight text-balance text-base-text sm:text-4xl";
const surfaceCard = "rounded-2xl border border-base-border bg-base-background shadow-sm";
const focusRing =
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-base-background";
const interactiveHover = "transition hover:border-primary/30 hover:bg-primary/4 hover:[&_h3]:text-primary";
const interactiveCard =
    `group rounded-2xl border border-base-border bg-base-background shadow-sm ${interactiveHover} ${focusRing}`;
const unavailableChip =
    "inline-flex items-center gap-2 rounded-full border border-dashed border-base-border bg-base-background/60 px-3 py-1.5 text-sm text-base-subtle";
---

<BaseLayout pageTitle={title} {description}>
    <section class="relative isolate overflow-hidden border-b border-base-border">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(99,102,241,0.16),_transparent_38%),radial-gradient(circle_at_80%_15%,_rgba(56,189,248,0.16),_transparent_30%),linear-gradient(180deg,_rgba(99,102,241,0.08),_transparent_65%)]">
        </div>

        <div class:list={[sectionContainer, "pt-20 pb-16 lg:pt-28 lg:pb-24"]}>
            <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
                <div class="max-w-3xl">
                    <div class="inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/6 px-3 py-1 text-sm text-primary">
                        <icons.GraduationCap class="size-4" aria-hidden="true" />
                        <span>Curso online de nivel universitario</span>
                    </div>

                    <h1 class="mt-7 max-w-4xl text-5xl font-semibold tracking-tight text-balance text-base-text sm:text-6xl lg:text-6xl">
                        {site.LONG_TITLE}
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-base-subtle sm:text-xl">
                        Aprende a diseñar bibliotecas de software robustas, reutilizables, verificables y capaces de
                        evolucionar sin romper a quienes dependen de ellas.
                    </p>

                    <div class="mt-8 flex flex-wrap items-center gap-4">
                        <a
                            href="/notes/"
                            class:list={[
                                "inline-flex items-center justify-center gap-2 rounded-md bg-primary-dark px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary-darker",
                                focusRing,
                            ]}
                        >
                            <icons.ArrowRight class="size-4" aria-hidden="true" />
                            Explorar apuntes
                        </a>

                        <span aria-label="Bibliografía, próximamente" class={unavailableChip}>
                            <icons.BookOpenText class="size-4" aria-hidden="true" />
                            Bibliografía · Próximamente
                        </span>
                    </div>
                </div>

                <article class="rounded-2xl border border-primary/20 bg-base-background/85 p-5 shadow-sm backdrop-blur">
                    <div class="flex items-center gap-3 text-primary">
                        <icons.BookOpenText class="size-5" aria-hidden="true" />
                        <span class="text-sm font-medium">Disponible ahora</span>
                    </div>
                    <p class="mt-3 text-2xl font-semibold text-base-text">Apuntes técnicos</p>
                    <p class="mt-2 text-sm leading-6 text-base-subtle">
                        El material más desarrollado del curso: notas, ejemplos y progresión por unidades, listos para
                        estudiar de forma autónoma.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section class:list={[sectionContainer, "py-16"]}>
        <div class="max-w-3xl">
            <p class={sectionKicker}>¿Qué es DIBS?</p>
            <h2 class={sectionTitle}>
                Un curso online de nivel universitario para el estudio autónomo
            </h2>
            <p class="mt-4 leading-7 text-base-subtle">
                DIBS es un curso a tu propio ritmo, con la profundidad de un curso de nivel universitario, sin implicar
                matrícula ni una institución formal detrás. Los apuntes combinan explicaciones conceptuales con ejemplos
                prácticos pensados para volver sobre ellos más de una vez.
            </p>
        </div>

        <div class="mt-6 max-w-3xl rounded-2xl border border-base-border bg-base-background/60 px-5 py-4">
            <div class="flex items-start gap-3">
                <icons.Translate class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
                <p class="text-sm leading-6 text-base-subtle">
                    El curso se dicta íntegramente en español.
                </p>
            </div>
        </div>

        <ul class="mt-10 grid gap-4 md:grid-cols-3">
            {
                learningPillars.map((pillar) => {
                    const Icon = icons[pillar.icon];
                    return (
                    <li class="list-none">
                        <article class:list={[surfaceCard, "p-6"]}>
                            <Icon class="size-6 text-primary" aria-hidden="true" />
                            <h3 class="mt-4 text-lg font-semibold text-base-text">
                                {pillar.title}
                            </h3>
                            <p class="mt-3 leading-7 text-base-subtle">{pillar.body}</p>
                        </article>
                    </li>
                );
                })
            }
        </ul>
    </section>

    <section class="border-y border-base-border bg-primary/4">
        <div class:list={[sectionContainer, "py-16"]}>
            <div class="max-w-3xl">
                <p class={sectionKicker}>Arquitectura de referencia</p>
                <h2 class={sectionTitle}>
                    El sitio DIBS también es una implementación de referencia
                </h2>
                <p class="mt-4 leading-7 text-base-subtle">
                    El sitio DIBS usa esta organización en capas como arquitectura de referencia para las ideas del
                    curso, no como una regla universal que toda biblioteca deba seguir. La Presentación depende de la
                    Aplicación, que depende del Dominio; la Infraestructura, en cambio, implementa los contratos que el
                    Dominio y la Aplicación declaran, sin que el Dominio dependa de ella.
                </p>
            </div>

            <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {
                    architectureLayers.map((layer) => {
                        const Icon = icons[layer.icon];
                        return (
                        <li class="list-none">
                            <article
                                class:list={[
                                    "h-full rounded-2xl border p-6 shadow-sm",
                                    layer.core
                                        ? "border-primary/40 bg-base-background"
                                        : "border-base-border bg-base-background/80",
                                ]}
                            >
                                <div class="flex items-center justify-between gap-2">
                                    <Icon
                                        class:list={[
                                            "size-6",
                                            layer.core ? "text-primary" : "text-base-subtle",
                                        ]}
                                        aria-hidden="true"
                                    />
                                    {
                                        layer.core && (
                                            <span
                                                class="rounded-full bg-primary/12 px-2.5 py-1 text-xs font-medium text-primary"
                                            >
                                                Núcleo conceptual
                                            </span>
                                        )
                                    }
                                </div>
                                <h3 class="mt-4 text-lg font-semibold text-base-text">
                                    {layer.name}
                                </h3>
                                <p class="mt-3 leading-7 text-base-subtle">{layer.role}</p>
                            </article>
                        </li>
                    );
                    })
                }
            </ul>
        </div>
    </section>

    <section class:list={[sectionContainer, "py-16"]}>
        <div class="max-w-3xl">
            <p class={sectionKicker}>Stack tecnológico</p>
            <h2 class={sectionTitle}>
                Tecnologías detrás de la implementación de referencia
            </h2>
            <p class="mt-4 leading-7 text-base-subtle">
                Las herramientas concretas que usa el sitio para construir esa arquitectura de referencia.
            </p>
        </div>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {
                techStack.map((item) => {
                    const Icon = icons[item.icon];
                    return (
                    <li class="list-none">
                        <article class:list={[surfaceCard, "h-full p-5"]}>
                            <Icon class="size-6 text-primary" aria-hidden="true" />
                            <p class="mt-3 font-semibold text-base-text">{item.name}</p>
                            <p class="mt-2 text-sm leading-6 text-base-subtle">{item.role}</p>
                        </article>
                    </li>
                );
                })
            }
        </ul>
    </section>

    <section class="border-t border-base-border bg-base-background/60">
        <div class:list={[sectionContainer, "py-16"]}>
            <div class="max-w-3xl">
                <p class={sectionKicker}>Cómo seguir el curso</p>
                <h2 class={sectionTitle}>Empieza por los apuntes</h2>
            </div>

            <div class="mt-8 flex flex-wrap items-stretch gap-4">
                <a
                    href="/notes/"
                    class:list={[interactiveCard, "flex min-w-64 flex-1 items-center gap-4 p-5 sm:flex-none"]}
                >
                    <div class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <icons.ArrowCircleRight
                            class="size-5 transition group-hover:translate-x-0.5" aria-hidden="true"
                        />
                    </div>
                    <div>
                        <p class="text-lg font-semibold text-base-text">Apuntes</p>
                        <p class="mt-1 text-sm leading-6 text-base-subtle">
                            La ruta de estudio disponible hoy.
                        </p>
                    </div>
                </a>

                <span aria-label="Temario, próximamente" class={unavailableChip}>
                    Temario · Próximamente
                </span>

                <span aria-label="Bibliografía, próximamente" class={unavailableChip}>
                    Bibliografía · Próximamente
                </span>
            </div>
        </div>
    </section>
</BaseLayout>
