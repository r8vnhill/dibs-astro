---
import { getDefaultBibliographyCatalog } from "$presentation/adapters/bibliography-catalog";
import GuidedReferenceEntry from "~/components/ui/references/GuidedReferenceEntry.astro";
import { type LessonReading, libraryWhatIsReadings } from "~/data/readings/lesson-readings";
import BaseLayout from "~/layouts/BaseLayout.astro";

const catalog = getDefaultBibliographyCatalog();
const referenceFor = (reading: LessonReading) =>
    catalog.referencesById.get(`ref:${reading.referenceId}`) ?? catalog.referencesById.get(reading.referenceId);
const sections = [
    { id: "essential-heading", title: "Lecturas esenciales", readings: libraryWhatIsReadings.essential },
    { id: "practice-heading", title: "De la idea a la práctica", readings: libraryWhatIsReadings.practice },
    { id: "deeper-heading", title: "Para profundizar", readings: libraryWhatIsReadings.deeper },
] as const;
---

<BaseLayout pageTitle={`Lecturas · ${libraryWhatIsReadings.title}`}>
    <main class="mx-auto max-w-4xl px-6 py-12">
        <p><a href="/readings/">← Todas las lecturas</a></p>
        <h1 class="mt-6">{libraryWhatIsReadings.title}</h1>
        <p class="mt-4">Referencias para profundizar en los conceptos de la lección.</p>
        <p class="mt-2"><a href={libraryWhatIsReadings.lessonPath}>Volver a la lección</a></p>

        <aside class="mt-8 rounded-lg border border-base-border bg-base-surface p-5" aria-labelledby="route-heading">
            <h2 id="route-heading" class="text-xl font-semibold">Cómo usar estas lecturas</h2>
            <p class="mt-3">
                No necesitas leer todas estas fuentes. Para consolidar las ideas centrales, comienza por la introducción
                de Kotlin y Parnas; después, elige una rama según tu interés: diseño de APIs, compatibilidad o
                mecanismos de otros lenguajes.
            </p>
        </aside>

        {
            sections.map(({ id, title, readings }) => (
                <section class="mt-12" aria-labelledby={id}>
                    <h2 {id}>{title}</h2>
                    <ul class="mt-6 space-y-5">
                        {
                            readings.map((reading) => {
                                const reference = referenceFor(reading);
                                return reference ? <GuidedReferenceEntry {reference} {reading} />: null;
                                               })
                        }
                    </ul>
                </section>
            ))
        }
    </main>
</BaseLayout>
