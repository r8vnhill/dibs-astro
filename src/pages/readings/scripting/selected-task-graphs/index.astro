---
import { getDefaultBibliographyCatalog } from "$presentation/adapters/bibliography-catalog";
import { getSelectedTaskGraphsReadings } from "$presentation/adapters/lesson-readings";
import GuidedReferenceEntry from "~/components/ui/references/GuidedReferenceEntry.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { formatLessonReadingsDiagnostics, resolveLessonReadings } from "~/lib/readings/lesson-readings-contract";

const selectedTaskGraphsReadings = getSelectedTaskGraphsReadings();
const resolution = resolveLessonReadings(selectedTaskGraphsReadings, getDefaultBibliographyCatalog());
if (!resolution.ok) {
    throw new Error(`Lesson readings resolution failed:\n${formatLessonReadingsDiagnostics(resolution.diagnostics)}`);
}
const { sections } = resolution.value;
---

<BaseLayout pageTitle={`Lecturas · ${selectedTaskGraphsReadings.title}`}>
    <main class="mx-auto max-w-4xl px-6 py-12">
        <p><a href="/readings/">← Todas las lecturas</a></p>
        <h1 class="mt-6">{selectedTaskGraphsReadings.title}</h1>
        <p class="mt-4">Referencias para estudiar la selección de tareas y su realización en Gradle.</p>
        <p class="mt-2"><a href={selectedTaskGraphsReadings.lessonPath}>Volver a la lección</a></p>

        <aside class="mt-8 rounded-lg border border-base-border bg-base-surface p-5" aria-labelledby="route-heading">
            <h2 id="route-heading" class="text-xl font-semibold">Cómo usar estas lecturas</h2>
            <p class="mt-3">
                Comienza por las referencias de Gradle para conectar el grafo seleccionado con un sistema real. Después,
                usa la documentación de línea de comandos para observar el grafo que Gradle prepara para una invocación
                concreta.
            </p>
            <p class="mt-3">
                No necesitas leer todo de una vez. Cada entrada indica qué buscar y qué idea conviene llevarse a la
                lección.
            </p>
        </aside>

        <section class="mt-12 rounded-lg border border-base-border p-5" aria-labelledby="advanced-heading">
            <h2 id="advanced-heading">Para contextualizar el costo de construir el grafo</h2>
            <p class="mt-3">
                Construir y configurar un grafo también requiere trabajo. La{" "}
                <a href="https://docs.gradle.org/current/userguide/configuration_cache.html">
                    Configuration Cache de Gradle
                </a> conserva el resultado de la fase de configuración para poder reutilizarlo en invocaciones
                posteriores; no es lo mismo que reutilizar los outputs de una tarea mediante el Build Cache.
            </p>
            <p class="mt-3">
                Gradle 9.7 presenta <a href="https://docs.gradle.org/current/userguide/isolated_projects.html">
                    Isolated Projects
                </a> como una función <strong>incubating</strong>: busca aislar la configuración de proyectos para
                mejorar la escalabilidad de builds grandes, pero sus APIs y comportamiento todavía pueden cambiar.
            </p>
        </section>

        {
            sections.map(({ id, title, readings }) => (
                <section class="mt-12" aria-labelledby={id}>
                    <h2 {id}>{title}</h2>
                    <ul class="mt-6 space-y-5">
                        {
                            readings.map((reading) => (
                                <GuidedReferenceEntry reference={reading.reference} reading={reading.guide} />
                            ))
                        }
                    </ul>
                </section>
            ))
        }
    </main>
</BaseLayout>
