---
import { getDefaultBibliographyCatalog } from "$presentation/adapters/bibliography-catalog";
import { getTaskGraphsReadings } from "$presentation/adapters/lesson-readings";
import GuidedReferenceEntry from "~/components/ui/references/GuidedReferenceEntry.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { formatLessonReadingsDiagnostics, resolveLessonReadings } from "~/lib/readings/lesson-readings-contract";

const taskGraphsReadings = getTaskGraphsReadings();
const resolution = resolveLessonReadings(taskGraphsReadings, getDefaultBibliographyCatalog());
if (!resolution.ok) {
    throw new Error(`Lesson readings resolution failed:\n${formatLessonReadingsDiagnostics(resolution.diagnostics)}`);
}
const { sections } = resolution.value;
---

<BaseLayout pageTitle={`Lecturas · ${taskGraphsReadings.title}`}>
    <main class="mx-auto max-w-4xl px-6 py-12">
        <p><a href="/readings/">← Todas las lecturas</a></p>
        <h1 class="mt-6">{taskGraphsReadings.title}</h1>
        <p class="mt-4">Referencias para profundizar en las dependencias entre tareas y los grafos acíclicos.</p>
        <p class="mt-2"><a href={taskGraphsReadings.lessonPath}>Volver a la lección</a></p>

        <aside class="mt-8 rounded-lg border border-base-border bg-base-surface p-5" aria-labelledby="route-heading">
            <h2 id="route-heading" class="text-xl font-semibold">Cómo usar estas lecturas</h2>
            <p class="mt-3">
                Comienza por las referencias sobre grafos dirigidos y órdenes topológicos. Después, usa las lecturas
                sobre diseño de sistemas de construcción para ampliar la idea de dependencias y razonar sobre corrección
                y paralelismo.
            </p>
            <p class="mt-3">
                No necesitas leer todo de una vez. Cada entrada indica qué buscar y qué idea conviene llevarse a la
                lección.
            </p>
        </aside>

        {
            sections.map(({ id, title, readings }) => (
                <section class="mt-12" aria-labelledby={id}>
                    <h2 {id}>{title}</h2>
                    <ul class="mt-6 space-y-5">
                        {
                            readings.map((reading) => (
                                <GuidedReferenceEntry reference={reading.reference} reading={reading.guide} />
                            ))
                        }
                    </ul>
                </section>
            ))
        }
    </main>
</BaseLayout>
