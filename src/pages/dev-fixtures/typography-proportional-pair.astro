---
/**
 * @fileoverview Browser fixture for evaluating the zero-cost DIBS proportional typography pair.
 *
 * Renders local DIBS faces, two local reference families, and a lesson-shaped three-role specimen.
 * The specimen uses the production Google Fonts stylesheet for Fira Code; candidate and reference
 * faces remain local.
 *
 * Candidate/reference prose, Spanish coverage, ligature corpus, and role-state matrices come from
 * `~/lib/typography`. The compact lesson excerpt stays in its component so its notation and
 * semantic structure can be reviewed together.
 *
 * Structure --- each `<section>` is one self-contained component in `./_components/`:
 *
 * - {@link RoleConformanceSection} (`body` / `heading`) --- one family at every required state.
 * - {@link HeadingEvaluationSection} --- `DIBS Slab` vs `Space Grotesk Reference 2.0.0`, stacked.
 * - {@link HeadingLayoutSection} --- heading text under a real reading-column + TOC layout.
 * - {@link LigatureComparisonSection} --- every sequence with feature-off and feature-on modes.
 * - {@link CombinedSystemSection} --- all three roles together in a lesson-shaped fragment.
 * - {@link BodyEvaluationSection} --- `DIBS Sans` vs `Inter Reference 4.1`, stacked.
 *
 * The stylesheet stays here as `<style is:global>` because the section components share its class
 * and attribute selectors; Astro's scoped styles would not reach across component
 * boundaries.
 *
 * This fixture stays outside course content and lesson discovery, metadata, and navigation.
 * It reuses the production stylesheet URL without rendering the metadata adapter or changing
 * production `Head.astro` behavior, family tokens, or weights. Keep
 * `<meta name="robots" content="noindex" />` as a secondary safeguard for deployed previews.
 */

import { productionFontStylesheetUrl } from "~/lib/typography/production-font-stylesheet";
import { proportionalFontContract } from "~/lib/typography/proportional-font-contract";
import "~/styles/global.css";
import BodyEvaluationSection from "./_components/BodyEvaluationSection.astro";
import CombinedSystemSection from "./_components/CombinedSystemSection.astro";
import HeadingEvaluationSection from "./_components/HeadingEvaluationSection.astro";
import HeadingLayoutSection from "./_components/HeadingLayoutSection.astro";
import LigatureComparisonSection from "./_components/LigatureComparisonSection.astro";
import RoleConformanceSection from "./_components/RoleConformanceSection.astro";

const { body, heading } = proportionalFontContract.roles;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>DIBS proportional pair fixture</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect" href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={productionFontStylesheetUrl} />
    <style is:global>
      /* Only combined code uses remote Fira; other fixture text keeps system fallbacks. */
      body,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: system-ui, sans-serif;
      }

      @font-face {
        font-family: "DIBS Sans";
        src: url("/fonts/dibs-sans/400-normal.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "DIBS Sans";
        src: url("/fonts/dibs-sans/400-italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: "DIBS Sans";
        src: url("/fonts/dibs-sans/500-normal.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "DIBS Sans";
        src: url("/fonts/dibs-sans/700-normal.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Inter Reference 4.1";
        src: url("/dev-fixtures/fonts/inter-4.1/400-normal.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Inter Reference 4.1";
        src: url("/dev-fixtures/fonts/inter-4.1/400-italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: "Inter Reference 4.1";
        src: url("/dev-fixtures/fonts/inter-4.1/500-normal.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Inter Reference 4.1";
        src: url("/dev-fixtures/fonts/inter-4.1/700-normal.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "DIBS Slab";
        src: url("/fonts/dibs-slab/500-normal.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "DIBS Slab";
        src: url("/fonts/dibs-slab/700-normal.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Space Grotesk Reference 2.0.0";
        src: url("/dev-fixtures/fonts/space-grotesk-2.0.0/500-normal.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Space Grotesk Reference 2.0.0";
        src: url("/dev-fixtures/fonts/space-grotesk-2.0.0/700-normal.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      [data-typography-specimen="ligature"][data-feature-mode="disabled"] {
        font-variant-ligatures: none;
      }

      [data-typography-specimen="ligature"][data-feature-mode="enabled"] {
        font-variant-ligatures: common-ligatures contextual;
      }

      [data-font-family="dibs-sans"] {
        font-family: "DIBS Sans", sans-serif;
      }

      [data-font-family="dibs-slab"] {
        font-family: "DIBS Slab", serif;
      }

      [data-font-family="fira-code"] {
        font-family: "Fira Code", ui-monospace, monospace;
        font-variant-ligatures: contextual;
      }

      [data-body-evaluation] {
        font-synthesis: none;
      }

      .body-evaluation-family {
        width: min(100%, 760px);
        margin-inline: auto;
      }

      .body-evaluation-state {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
        padding: 1rem;
        border: 1px solid currentColor;
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      .body-evaluation-surface {
        margin: 0;
      }

      .body-evaluation-weight-sample {
        margin: 0;
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      .body-evaluation-surface > h5 {
        margin: 0 0 0.5rem;
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .body-evaluation-prose {
        font-size: 1.0625rem;
        line-height: 1.65;
      }

      .body-evaluation-prose + .body-evaluation-prose {
        margin-top: 1.1rem;
      }

      .body-evaluation-ui {
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .body-evaluation-ui-large {
        font-size: 1rem;
        line-height: 1.5;
      }

      .body-evaluation-inline-code {
        border-radius: 0.25rem;
        background: color-mix(in srgb, currentColor 10%, transparent);
        padding: 0.08em 0.28em;
      }

      .body-evaluation-navigation,
      .body-evaluation-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
        align-items: baseline;
      }

      .body-evaluation-list {
        padding-inline-start: 1.5rem;
      }

      .body-evaluation-callout {
        border-inline-start: 3px solid currentColor;
        padding: 0.75rem 1rem;
      }

      .body-evaluation-callout p {
        margin: 0;
        line-height: 1.6;
      }

      main {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 2rem;
        max-width: 100%;
      }

      .heading-evaluation-review,
      .heading-evaluation-layout {
        width: min(100%, 84ch);
        margin-inline: auto;
      }

      .heading-evaluation-case {
        margin-top: 2rem;
      }

      .heading-evaluation-case-label,
      .heading-evaluation-family-label,
      .heading-evaluation-state-label {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .heading-evaluation-family-label,
      .heading-evaluation-state-label {
        color: var(--theme-color-primary);
        font-weight: 700;
      }

      .heading-evaluation-pair {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 0.75rem;
      }

      .heading-evaluation-specimen {
        margin: 0;
        font-synthesis: none;
        font-variant-ligatures: common-ligatures contextual;
        line-height: 1.3;
        overflow-wrap: anywhere;
      }

      .heading-evaluation-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--sidebar-page, 20rem);
        gap: 2rem;
        max-width: calc(84ch + var(--sidebar-page, 20rem) + 2rem);
      }

      .heading-evaluation-reading-column {
        min-width: 0;
      }

      .heading-evaluation-toc {
        align-self: start;
        min-width: 0;
        border-inline-start: 1px solid currentColor;
        padding-inline: 0.75rem;
      }

      .heading-evaluation-toc ol {
        margin: 0.75rem 0 0;
        padding-inline-start: 1.25rem;
      }

      .heading-evaluation-toc a {
        display: block;
        overflow-wrap: anywhere;
        font-size: 0.875rem;
        line-height: 1.375;
      }

      pre {
        max-width: 100%;
        overflow-x: auto;
      }

      @media (max-width: 1279px) {
        .heading-evaluation-layout {
          grid-template-columns: minmax(0, 1fr);
        }

        .heading-evaluation-toc {
          border-inline-start: 0;
          border-block-start: 1px solid currentColor;
          padding-block-start: 1rem;
          padding-inline: 0;
        }
      }

      .ligature-comparison {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .ligature-comparison-state {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .ligature-comparison-header,
      .ligature-comparison-row {
        display: grid;
        grid-template-columns: minmax(5rem, 0.35fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
        align-items: baseline;
      }

      .ligature-comparison-header {
        font-size: 0.875rem;
        font-weight: 700;
      }

      .ligature-comparison-row {
        border-top: 1px solid currentColor;
        padding-top: 0.5rem;
      }

      .ligature-comparison-row > code {
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="fixture-guide">
        Esta página permite comparar familias y estados tipográficos con el contenido y la
        composición controlados. Al revisar la muestra final, observa la jerarquía de los títulos,
        la comodidad de lectura de la prosa y la legibilidad del código en pantallas amplias y
        estrechas.
      </p>

      <RoleConformanceSection
        sectionId="body" role="body"
        fontFamily="dibs-sans" title="DIBS Sans — body conformance"
        states={body.states}
      />

      <RoleConformanceSection
        sectionId="heading" role="heading"
        fontFamily="dibs-slab" title="DIBS Slab — heading conformance"
        states={heading.states}
      />

      <HeadingEvaluationSection />

      <HeadingLayoutSection />

      <LigatureComparisonSection />

      <CombinedSystemSection />

      <BodyEvaluationSection />
    </main>
  </body>
</html>
