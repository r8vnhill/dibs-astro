---
/**
 * @fileoverview Browser fixture for evaluating the zero-cost DIBS proportional typography pair.
 *
 * Renders `DIBS Sans` (body/UI) and `DIBS Slab` (headings) from the locally generated WOFF2 assets in
 * `public/fonts/`, alongside the unchanged `Fira Code` monospace stack. No Google Fonts, trial stylesheet,
 * account-specific CDN, or other commercial service participates in loading either candidate family: both are
 * declared through local `@font-face` rules pointing at the committed, provenance-tracked WOFF2 files.
 *
 * All specimen text, Spanish coverage, ligature corpus, and required weight/style states are read directly from
 * {@link proportionalFontContract} rather than invented locally, so this fixture cannot drift from the typography
 * conformance contract it exists to evaluate.
 *
 * Sections:
 *
 * - `data-fixture-section="body"` --- `DIBS Sans` rendered at every required body state.
 * - `data-fixture-section="heading"` --- `DIBS Slab` rendered at every required heading state.
 * - `data-fixture-section="ligature-comparison"` --- every canonical sequence rendered with explicit feature-off
 *   and feature-on modes for every required role state.
 * - `data-fixture-section="combined"` --- a realistic lesson-shaped fragment combining `DIBS Sans`, `DIBS Slab`,
 *   and `Fira Code` to evaluate the three-role system as a whole.
 *
 * Repository boundary
 * -------------------
 *
 * Keep this page outside `src/pages/notes/**`. It is a typography-evaluation fixture, not course content, so it
 * must not participate in lesson discovery, lesson metadata generation, or curricular navigation. Production
 * typography (`Inter` / `Space Grotesk` / `Fira Code`) is unaffected: this fixture never touches `Head.astro` or
 * the site-wide typography tokens in `src/styles/theme/typography.css`.
 *
 * Keep `<meta name="robots" content="noindex" />` as a secondary safeguard for deployed previews.
 */

import { proportionalFontContract } from "~/lib/typography/proportional-font-contract";
import {
    proportionalFontFeatureModes,
    proportionalFontFixtureProfiles,
    typographyLigaturePairKey as pairKey,
    typographySpecimenStyle as specimenStyle,
    typographyStateKey,
} from "~/lib/typography/proportional-font-fixture";
import "~/styles/global.css";

const { body, heading } = proportionalFontContract.roles;
const { ligatures, spanishCoverage, specimenText } = proportionalFontContract;

const spanishCoverageLine = spanishCoverage.join(" ");
---

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex" />
        <title>DIBS proportional pair fixture</title>
        <style>
            @font-face {
                font-family: "DIBS Sans";
                src: url("/fonts/dibs-sans/400-normal.woff2") format("woff2");
                font-weight: 400;
                font-style: normal;
                font-display: swap;
            }

            @font-face {
                font-family: "DIBS Sans";
                src: url("/fonts/dibs-sans/400-italic.woff2") format("woff2");
                font-weight: 400;
                font-style: italic;
                font-display: swap;
            }

            @font-face {
                font-family: "DIBS Sans";
                src: url("/fonts/dibs-sans/500-normal.woff2") format("woff2");
                font-weight: 500;
                font-style: normal;
                font-display: swap;
            }

            @font-face {
                font-family: "DIBS Sans";
                src: url("/fonts/dibs-sans/700-normal.woff2") format("woff2");
                font-weight: 700;
                font-style: normal;
                font-display: swap;
            }

            @font-face {
                font-family: "DIBS Slab";
                src: url("/fonts/dibs-slab/500-normal.woff2") format("woff2");
                font-weight: 500;
                font-style: normal;
                font-display: swap;
            }

            @font-face {
                font-family: "DIBS Slab";
                src: url("/fonts/dibs-slab/700-normal.woff2") format("woff2");
                font-weight: 700;
                font-style: normal;
                font-display: swap;
            }

            [data-typography-specimen="ligature"][data-feature-mode="disabled"] {
                font-variant-ligatures: none;
            }

            [data-typography-specimen="ligature"][data-feature-mode="enabled"] {
                font-variant-ligatures: common-ligatures contextual;
            }

            [data-font-family="dibs-sans"] {
                font-family: "DIBS Sans", sans-serif;
            }

            [data-font-family="dibs-slab"] {
                font-family: "DIBS Slab", serif;
            }

            [data-font-family="fira-code"] {
                font-family: "Fira Code", ui-monospace, monospace;
                font-variant-ligatures: contextual;
            }

            main {
                display: flex;
                flex-direction: column;
                gap: 2rem;
                padding: 2rem;
                max-width: 72ch;
            }

            .ligature-comparison {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .ligature-comparison-state {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
            }

            .ligature-comparison-header,
            .ligature-comparison-row {
                display: grid;
                grid-template-columns: minmax(5rem, 0.35fr) minmax(0, 1fr) minmax(0, 1fr);
                gap: 1rem;
                align-items: baseline;
            }

            .ligature-comparison-header {
                font-size: 0.875rem;
                font-weight: 700;
            }

            .ligature-comparison-row {
                border-top: 1px solid currentColor;
                padding-top: 0.5rem;
            }

            .ligature-comparison-row > code {
                font-size: 0.875rem;
            }
        </style>
    </head>
    <body>
        <main>
            <section
                data-fixture-section="body" data-typography-role="body"
                data-font-family="dibs-sans"
            >
                <h2>DIBS Sans &mdash; body conformance</h2>

                {
                    body.states.map((state) => (
                        <article
                            data-typography-state={`${state.weight}-${state.style}`}
                            style={`font-weight:${state.weight}; font-style:${state.style};`}
                        >
                            <h3>
                                {state.weight}
                                {" "}
                                {state.style}
                            </h3>

                            {specimenText.map((line) => <p>{line}</p>)}

                            <p data-typography-corpus="spanish-coverage">{spanishCoverageLine}</p>
                        </article>
                    ))
                }
            </section>

            <section
                data-fixture-section="heading" data-typography-role="heading"
                data-font-family="dibs-slab"
            >
                <h2>DIBS Slab &mdash; heading conformance</h2>

                {
                    heading.states.map((state) => (
                        <article
                            data-typography-state={`${state.weight}-${state.style}`}
                            style={`font-weight:${state.weight}; font-style:${state.style};`}
                        >
                            <h3>
                                {state.weight}
                                {" "}
                                {state.style}
                            </h3>

                            {specimenText.map((line) => <p>{line}</p>)}

                            <p data-typography-corpus="spanish-coverage">{spanishCoverageLine}</p>
                        </article>
                    ))
                }
            </section>

            <section
                class="ligature-comparison" data-fixture-section="ligature-comparison"
                data-visual-review="ligature-comparison"
            >
                <h2>Ligature feature comparison</h2>
                <p>
                    Las ligaduras pueden unir ciertos pares o grupos de caracteres. Esta tabla conserva el mismo texto
                    fuente en ambas columnas y cambia solamente las funciones OpenType del navegador: desactivadas o
                    activadas. Las secuencias comunes y técnicas permiten observar qué aporta cada archivo de fuente.
                </p>

                {
                    proportionalFontFixtureProfiles.map((candidate) => (
                        <section
                            data-typography-role={candidate.role} data-font-family={candidate.familyId}
                            data-comparison-family={candidate.familyName}
                        >
                            <h3>{candidate.familyName}</h3>

                            {
                                candidate.states.map((state) => (
                                    <article
                                        class="ligature-comparison-state"
                                        data-typography-state={typographyStateKey(state)}
                                        data-visual-review-state={state.weight === candidate.states[0].weight
                                                && state.style === candidate.states[0].style
                                            ? "representative"
                                            : undefined}
                                    >
                                        <h4>
                                            {state.weight}
                                            {" "}
                                            {state.style}
                                        </h4>

                                        <div class="ligature-comparison-header" aria-hidden="true">
                                            <span>Sequence</span>
                                            {proportionalFontFeatureModes.map((mode) => <span>{mode.label}</span>)}
                                        </div>

                                        {
                                            ligatures.map((ligature) => (
                                                <div
                                                    class="ligature-comparison-row"
                                                    data-ligature-pair={pairKey(candidate.role, state, ligature.id)}
                                                >
                                                    <code>{ligature.source}</code>
                                                    {
                                                        proportionalFontFeatureModes.map((mode) => (
                                                            <span
                                                                data-typography-specimen="ligature"
                                                                data-typography-role={candidate.role}
                                                                data-font-family={candidate.familyId}
                                                                data-typography-state={typographyStateKey(state)}
                                                                data-ligature-id={ligature.id}
                                                                data-ligature-category={ligature.category}
                                                                data-feature-mode={mode.id}
                                                                style={specimenStyle(candidate.diagnosticSize, state)}
                                                            >
                                                                {ligature.source}
                                                            </span>
                                                        ))
                                                    }
                                                </div>
                                            ))
                                        }
                                    </article>
                                ))
                            }
                        </section>
                    ))
                }
            </section>

            <section data-fixture-section="combined">
                <h2 data-font-family="dibs-slab" style="font-weight: 700">DIBS Sans + DIBS Slab + Fira Code</h2>

                <p data-font-family="dibs-sans" style="font-weight: 400">{specimenText[0]}</p>

                <p data-font-family="dibs-sans" style="font-weight: 400; font-style: italic">{specimenText[1]}</p>

                <p data-font-family="dibs-sans" style="font-weight: 500">{specimenText[2]}</p>

                <pre data-font-family="fira-code"><code>{specimenText[3]}
{specimenText[4]}</code></pre>
            </section>
        </main>
    </body>
</html>
