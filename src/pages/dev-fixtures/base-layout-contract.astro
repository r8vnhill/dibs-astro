 * discovery and curricular metadata generation do not include it.
 */
import BaseLayout from "$layouts/BaseLayout.astro";
---

<!-- Minimal browser fixture for the normal BaseLayout contract. -->
<BaseLayout pageTitle="Contrato de BaseLayout" description="Fixture del contrato de layout">
