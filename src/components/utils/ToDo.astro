---
import { DEFAULT_TODO_REPORT_EVENT, type ToDoMetadata } from "./todo-report";

export interface Props {
    /**
     * Optional debug metadata (e.g., title, tasks, etc.).
     * This is not rendered in the UI but can help with debugging.
     */
    metadata?: ToDoMetadata;

    /**
     * Optional message to display below the image.
     * Defaults to a friendly placeholder note.
     */
    message?: string;

    /**
     * Alternative text for the image.
     * Defaults to "Meme".
     */
    altText?: string;

    /**
     * Custom DOM event name to dispatch on `window` with the reporting payload.
     * Defaults to `"dibs:placeholder"` when omitted or set to `undefined`. Set to `null` to disable event dispatch.
     */
    reportEventName?: string | null | undefined;
}

const {
    metadata,
    message = "TODO: Estamos (estoy) trabajando para ustedes c:",
    altText = "Meme",
    reportEventName,
} = Astro.props;

const messageId = `todo-message__${crypto.randomUUID()}`;

// `undefined` (or the prop being omitted) resolves to the default event; `null` disables dispatch entirely.
const resolvedReportEventName = reportEventName === null ? null : (reportEventName ?? DEFAULT_TODO_REPORT_EVENT);
---

<dibs-todo
    data-alt-text={altText} data-message={message}
    data-metadata={metadata ? JSON.stringify(metadata) : undefined}
    {...resolvedReportEventName ? { "data-report-event-name": resolvedReportEventName } : {}}
>
    <figure
        aria-describedby={messageId}
        class="flex flex-col items-center gap-4 rounded border border-dashed border-primary p-4"
    >
        <div data-todo-image class="w-full max-w-xs">
            <div class="text-sm text-red-600">
                ⚠️ Imagen no disponible
            </div>
        </div>

        <figcaption id={messageId} class="text-center text-sm italic">
            {message}
            <br />Esta sección podría estar incompleta :0
        </figcaption>
    </figure>
</dibs-todo>

<script>
    import { getPlaceholderImagePool } from "$presentation/adapters/static-ui-data";
    import { pickRandom } from "~/utils";
    import { type ToDoMetadata, type ToDoReportPayload } from "./todo-report";

    class DibsTodo extends HTMLElement {
        connectedCallback() {
            if (this.dataset.todoInitialized === "true") return;
            this.dataset.todoInitialized = "true";

            const imageSrc = pickRandom([...getPlaceholderImagePool()]) ?? null;
            const imageRegion = this.querySelector<HTMLElement>("[data-todo-image]");

            if (imageRegion && imageSrc) {
                const image = document.createElement("img");
                image.src = imageSrc;
                image.alt = this.dataset.altText ?? "Meme";
                image.className = "w-full max-w-xs rounded shadow";
                imageRegion.replaceChildren(image);
            }

            let metadata: ToDoMetadata | undefined;
            if (this.dataset.metadata) {
                try {
                    metadata = JSON.parse(this.dataset.metadata) as ToDoMetadata;
                } catch {
                    metadata = undefined;
                }
            }

            const payload: ToDoReportPayload = {
                message: this.dataset.message ?? "",
                imageSrc,
                ...(metadata ? { metadata } : {}),
                timestamp: new Date().toISOString(),
            };

            console.warn(
                "⚠️ [ToDo]: This component is a placeholder. Replace it with real content.",
                metadata,
            );

            const eventName = this.dataset.reportEventName;
            if (eventName) {
                window.dispatchEvent(new CustomEvent(eventName, { detail: payload }));
            }
        }
    }

    customElements.define("dibs-todo", DibsTodo);
</script>
