---
import * as icons from "@ravenhill/astro-icons";
import { m } from "~/generated/i18n/messages";
import ExcludeFromReadingTime from "./ExcludeFromReadingTime.astro";

type Props = Readonly<{
    minutes: number;
    className?: string;
    label?: string;
}>;

const {
    minutes,
    className = "",
    label,
} = Astro.props as Props;

const minuteLabel = m.reading_time_minutes({ count: minutes });
const visibleLabel = label ? `${label}: ${minuteLabel}` : `${minuteLabel} ${m.reading_time_suffix()}`;
---

<ExcludeFromReadingTime className="contents" data-export-hidden="true">
    <span
        data-reading-time
        class:list={[
            "not-prose",
            "inline-flex",
            "items-center",
            "gap-1.5",
            "text-[var(--rt-fg,inherit)]",
            className,
        ]}
        title={m.reading_time_help()}
    >
        <span class="text-primary"><icons.Clock class="h-4 w-4" aria-hidden="true" /></span>
        <span>{visibleLabel}</span>
    </span>
</ExcludeFromReadingTime>
