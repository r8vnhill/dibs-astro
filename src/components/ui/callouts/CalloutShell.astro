---
import * as icons from "@ravenhill/astro-icons";
import type { AstroComponentFactory } from "~/types/astro-component";
import CalloutHeading from "./CalloutHeading.astro";
import {
    calloutBaseClasses,
    calloutColors,
    calloutVariants,
    filterSectionAttrs,
    proseClasses,
    slugifyTitle,
} from "./shared";
import type { BaseCalloutProps, CalloutVariant } from "./shared";

export interface CalloutShellProps extends BaseCalloutProps {
    variant: CalloutVariant;
    title?: string;
    icon?: AstroComponentFactory | null;
    id?: string;
    bodyClass?: string;
    collapsible?: boolean;
    defaultOpen?: boolean;
    showChevron?: boolean;
    /**
     * Presents the callout as nested inside another callout (e.g. a `Solution` embedded in a
     * `Question`) instead of as an independent card: no outer shadow/margin, a quieter background,
     * and a narrower accent border.
     */
    embedded?: boolean;
}

const {
    variant,
    title,
    icon,
    headingLevel = "h3",
    headingId,
    class: className = "",
    headingClass = "",
    iconClass = "",
    iconProps = {},
    iconVariant = "outline",
    iconDecorative = true,
    ariaLabel,
    compact = false,
    prose = true,
    bodyClass = "",
    collapsible = false,
    defaultOpen = false,
    showChevron = true,
    embedded = false,
    id,
    ...rest
} = Astro.props as CalloutShellProps & Record<string, any>;

const variantConfig = calloutVariants[variant];
const colors = calloutColors[variant];

const resolvedTitle = title ?? variantConfig.title;
const resolvedIcon = icon === undefined ? variantConfig.icon : icon;
const titleSlotContent = await Astro.slots.render?.("title");
const hasTitleContent = Boolean(titleSlotContent && titleSlotContent.trim().length > 0);

const sectionId = slugifyTitle(resolvedTitle, variant, id);
const resolvedHeadingId = headingId ?? `${sectionId}__title`;

const passthrough = filterSectionAttrs(rest);
const sectionClassList = [
    ...(embedded ? ["callout", "relative", "rounded-md", "callout--embedded"] : calloutBaseClasses),
    embedded ? "px-3 py-2" : (compact ? "px-4 py-3" : "px-5 py-4"),
    className,
];
const bodyClassList = ["callout__body", prose && proseClasses, bodyClass];

const detailProps = collapsible && defaultOpen ? { open: true } : {};
---

<section
    id={sectionId} class:list={sectionClassList}
    role="region" aria-labelledby={resolvedHeadingId}
    data-callout data-variant={variant}
    {...(embedded ? { "data-embedded": "true" } : {})}
    style={{
        "--callout-bg-color": `var(--${variant}__bg-color, ${colors.bg})`,
        "--callout-border-color": `var(--${variant}__border-color, ${colors.border})`,
        "--callout-title-color": `var(--${variant}__title-color, ${colors.title})`,
        "--callout-icon-color": `var(--${variant}__title-color, ${colors.title})`,
        "--callout-bg-color-dark": `var(--${variant}__bg-color-dark, ${colors.bgDark ?? colors.bg})`,
        "--callout-border-color-dark": `var(--${variant}__border-color-dark, ${colors.borderDark ?? colors.border})`,
        "--callout-title-color-dark": `var(--${variant}__title-color-dark, ${colors.titleDark ?? colors.title})`,
    }}
    {...ariaLabel ? { "aria-label": ariaLabel } : {}} {...passthrough}
>
    {
        collapsible ? (
            <details class="group callout__details" {...detailProps}>
                <summary class="list-none callout__summary">
                    <CalloutHeading
                        Icon={resolvedIcon ?? undefined} {headingLevel}
                        headingId={resolvedHeadingId} class={headingClass}
                        {iconClass} {iconProps}
                        {iconVariant} {iconDecorative}
                        heading={resolvedTitle}
                    >
                        {hasTitleContent ? <slot name="title" /> : resolvedTitle}
                        <Fragment slot="actions">
                            <slot name="actions" />
                            {
                                showChevron && (
                                    <icons.CaretDown
                                        class="w-4 h-4 transition-transform duration-200 group-open:rotate-180 text-[var(--callout-title-color)]"
                                        aria-hidden="true"
                                    />
                                )
                            }
                        </Fragment>
                    </CalloutHeading>
                </summary>

                <div class:list={bodyClassList}>
                    <slot />
                </div>
            </details>
        ) : (
            <>
                <CalloutHeading
                    Icon={resolvedIcon ?? undefined} {headingLevel}
                    headingId={resolvedHeadingId} class={headingClass}
                    {iconClass} {iconProps}
                    {iconVariant} {iconDecorative}
                    heading={resolvedTitle}
                >
                    {hasTitleContent ? <slot name="title" /> : resolvedTitle}
                    <slot slot="actions" name="actions" />
                </CalloutHeading>

                <div class:list={bodyClassList}>
                    <slot />
                </div>
            </>
        )
    }
</section>

<style scoped>
    .callout {
        background-color: var(--callout-bg-color);
        border-left: 4px solid var(--callout-border-color);
        --callout-inline-code-bg-color: color-mix(in srgb, var(--callout-border-color) 6%, transparent);
        --callout-inline-code-border-color: color-mix(in srgb, var(--callout-border-color) 30%, transparent);
    }

    :global([data-theme="dark"]) :where(.callout) {
        background-color: var(--callout-bg-color-dark);
        border-left-color: var(--callout-border-color-dark);
        --callout-inline-code-bg-color: color-mix(in srgb, var(--callout-border-color-dark) 10%, transparent);
        --callout-inline-code-border-color: color-mix(in srgb, var(--callout-border-color-dark) 36%, transparent);
    }

    .callout__body :where(p:first-child) {
        margin-top: 0;
    }
    .callout__body :where(p:last-child) {
        margin-bottom: 0;
    }

    /* Inline identifiers remain monospace and bounded, but their article-level badge treatment is
       too prominent when several appear inside an already colored callout. Target only inline
       code roots: nested Shiki code and block-code descendants are left to their own styles. */
    .callout__body :global(code:not(pre code):not(code code)) {
        background-color: var(--callout-inline-code-bg-color);
        border-color: var(--callout-inline-code-border-color);
        box-shadow: none;
    }

    /* Automatically apply callout accent color to list item icons */
    :where(.callout) :where(.listitem__icon) {
        color: var(--callout-title-color);
    }

    /* Slotted content does not receive the component scope attribute, so bold text must be
       targeted globally from the scoped body wrapper. */
    .callout__body :global(:where(strong, b)) {
        color: var(--callout-title-color);
    }

    /* Embedded callouts (e.g. a Solution nested inside a Question) read as one pedagogical unit
       with their parent rather than as an independent card: no shadow/margin, a much quieter
       background, and a narrower accent border. Declared after `.callout` so it wins at equal
       specificity. */
    .callout--embedded {
        background-color: color-mix(in srgb, var(--callout-border-color) 10%, transparent);
        border-left-width: 2px;
        box-shadow: none;
        margin-block: 0;
    }

    :global([data-theme="dark"]) :where(.callout--embedded) {
        background-color: color-mix(in srgb, var(--callout-border-color-dark) 12%, transparent);
    }

    /* Question should interrupt the reading rhythm without resembling a major content section:
       derive its surface from the page background with only a subtle purple tint instead of a
       fully saturated fill, while the border/icon/heading stay strongly purple as the semantic
       cue. Skipped when embedded, since the parent Question already owns the surface there. */
    .callout[data-variant="question"]:not(.callout--embedded) {
        background-color: color-mix(in srgb, var(--callout-border-color) 8%, var(--color-background));
    }

    /* A closing reflection marks a transition without competing with instructional callouts. */
    .callout[data-variant="closing-reflection"] {
        margin-top: 1.5rem;
        margin-bottom: 0;
        border-left-width: 2px;
        background-color: color-mix(in srgb, var(--callout-border-color) 5%, transparent);
        box-shadow: none;
        padding: 0.1rem 1.25rem;
    }

    :global(.dark) :where(.callout[data-variant="question"]:not(.callout--embedded)),
    :global([data-theme="dark"]) :where(.callout[data-variant="question"]:not(.callout--embedded)) {
        background-color: color-mix(in srgb, var(--callout-border-color-dark) 14%, var(--color-background));
    }

    :global(.dark) :where(.callout[data-variant="closing-reflection"]),
    :global([data-theme="dark"]) :where(.callout[data-variant="closing-reflection"]) {
        background-color: color-mix(in srgb, var(--callout-border-color-dark) 10%, transparent);
    }

    /* Disclosure summary interaction states (rest / hover / keyboard focus). The native <summary>
       already provides toggle behavior; these styles only make its rest/hover/focus states
       discernible, per WCAG 2.2's focus-visibility guidance, without hiding the browser-provided
       disclosure semantics. */
    .callout__summary {
        cursor: pointer;
        border-radius: 0.375rem;
        transition: background-color 150ms ease;
    }

    .callout__summary::-webkit-details-marker {
        display: none;
    }

    .callout__summary:hover {
        background-color: color-mix(in srgb, var(--callout-border-color) 12%, transparent);
    }

    :global([data-theme="dark"]) :where(.callout__summary:hover) {
        background-color: color-mix(in srgb, var(--callout-border-color-dark) 16%, transparent);
    }

    .callout__summary:focus-visible {
        outline: 2px solid var(--callout-border-color);
        outline-offset: 2px;
    }

    :global([data-theme="dark"]) :where(.callout__summary:focus-visible) {
        outline-color: var(--callout-border-color-dark);
    }

    /* An embedded solution's collapsed state should read as a one-line disclosure affordance
       rather than a second card header; once opened, the answer sits below a subtle separator on
       the same quiet surface instead of introducing another saturated background. */
    .callout--embedded .callout__body {
        padding-left: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1px solid color-mix(in srgb, var(--callout-border-color) 25%, transparent);
    }

    .callout--embedded .callout__title {
        margin-bottom: 0;
        font-weight: 500;
    }

    :global([data-theme="dark"]) :where(.callout--embedded .callout__body) {
        border-top-color: color-mix(in srgb, var(--callout-border-color-dark) 30%, transparent);
    }
</style>
