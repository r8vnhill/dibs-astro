---
/**
 * Transitional callout used at the end of a lesson to connect its synthesis with the next
 * question or lesson.
 */
import CalloutShell from "./CalloutShell.astro";
import { calloutVariants } from "./shared";
import type { BaseCalloutProps } from "./shared";

const variant = "closing-reflection" as const;
const variantConfig = calloutVariants[variant];

const { title = variantConfig.title, icon = variantConfig.icon, compact = true, ...rest } = Astro.props as
    & BaseCalloutProps
    & Record<string, any>;
const hasTitleSlot = Astro.slots.has("title");
---

<CalloutShell
    {variant} {title}
    {icon} {compact}
    {...rest}
>
    {hasTitleSlot && <slot name="title" slot="title" />}
    <slot />
</CalloutShell>
