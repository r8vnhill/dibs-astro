---
import { NushellLogo } from "@ravenhill/astro-icons/custom";
import { resolveLanguageHref } from "./helpers";
import LangLink from "./LangLink.astro";

type Props = {
    slug?: string;
    name?: string;
    class?: string;
    srcLight?: string;
    srcDark?: string;
};

const {
    slug,
    name = "Nushell",
    class: className,
} = Astro.props as Props;

const { href } = resolveLanguageHref(Astro.url.pathname, slug, "nushell");
const hasDarkVariant = false;
const lightClass = hasDarkVariant
    ? "inline-block size-6 object-contain dark:hidden [image-rendering:crisp-edges]"
    : "inline-block size-6 object-contain [image-rendering:crisp-edges]";
---

<span class="contents">
    <LangLink
        {href} {name}
        class:list={[className]}
    >
        <Fragment slot="icon">
            <NushellLogo class={lightClass} aria-hidden="true" />
        </Fragment>
    </LangLink>
</span>
