---
import { Fish, FishSimple } from "$icons";
import { resolveLanguageHref } from "./helpers";
import LangLink from "./LangLink.astro";

type Props = {
    slug?: string;
    name?: string;
    class?: string;
    srcLight?: string;
    srcDark?: string;
};

const {
    slug,
    name = "fish",
    class: className,
} = Astro.props as Props;

const { href } = resolveLanguageHref(Astro.url.pathname, slug, "fish");
const hasDarkVariant = true;
const lightClass = hasDarkVariant
    ? "inline-block size-6 object-contain dark:hidden [image-rendering:crisp-edges]"
    : "inline-block size-6 object-contain [image-rendering:crisp-edges]";
---

<span class="contents">
    <LangLink
        {href} {name}
        class:list={[className]}
    >
        <Fragment slot="icon">
            <Fish class={lightClass} aria-hidden="true" />
            <FishSimple class="hidden dark:inline object-contain size-6" aria-hidden="true" />
        </Fragment>
    </LangLink>
</span>
