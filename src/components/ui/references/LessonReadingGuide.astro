---
import type { NormalizedReference } from "~/lib/bibliography";
import {
    type LessonReadingGuide as LessonReadingGuideModel,
    readingFormat,
} from "~/lib/readings/lesson-readings-contract";

interface Props {
    guide: LessonReadingGuideModel;
    reference: NormalizedReference;
    presentation?: "full" | "student";
}

const { guide, reference, presentation = "full" } = Astro.props;
const format = readingFormat(reference.type);
---

<div class="mt-3 text-sm text-base-subtle-text">
    <dl class="space-y-2">
        {
            presentation === "student" ? (
                <>
                    <div>
                        <dt class="font-semibold text-base-text">Nivel</dt>
                        <dd>{guide.difficulty}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Qué buscar</dt>
                        <dd>{guide.focus}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Idea que deberías llevarte</dt>
                        <dd>{guide.afterReading}</dd>
                    </div>
                </>
            ) : guide.role ? (
                <>
                    <div>
                        <dt class="font-semibold text-base-text">Formato</dt>
                        <dd>{format}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Rol en esta lección</dt>
                        <dd>{guide.role}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Dificultad</dt>
                        <dd>{guide.difficulty}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Extensión</dt>
                        <dd>{guide.extent}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Por qué leerlo</dt>
                        <dd>{guide.why}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">En qué enfocarse</dt>
                        <dd>{guide.focus}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Después de leer</dt>
                        <dd>{guide.afterReading}</dd>
                    </div>
                </>
            ) : (
                <>
                    <div>
                        <dt class="font-semibold text-base-text">Tipo</dt>
                        <dd>{guide.type ?? ""}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Dificultad</dt>
                        <dd>{guide.difficulty}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Extensión</dt>
                        <dd>{guide.extent}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Por qué leerlo</dt>
                        <dd>{guide.why}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">En qué enfocarse</dt>
                        <dd>{guide.focus}</dd>
                    </div>
                    <div>
                        <dt class="font-semibold text-base-text">Después de leer</dt>
                        <dd>{guide.afterReading}</dd>
                    </div>
                </>
            )
        }
        {
            guide.guidingQuestion && (
                <div>
                    <dt class="font-semibold text-base-text">Pregunta guía</dt>
                    <dd>{guide.guidingQuestion}</dd>
                </div>
            )
        }
    </dl>
</div>
