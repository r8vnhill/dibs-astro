---
/**
 * Renders the editorial guidance for a single lesson reading as three visual regions: the actionable prescription,
 * compact secondary metadata, and a visually distinct retrieval task. Data attributes on those regions form a stable
 * presentation contract for tests and browser-level accessibility checks.
 *
 * `guide` is the lesson-specific `LessonReadingGuide` authored in `src/data/readings/lesson-readings.ts`;
 * `reference` is the resolved bibliography entry it points to (see `~/lib/bibliography`). Both are required
 * because several fields — the reading format label and the estimated effort — depend on the reference's type
 * (e.g. only a `VideoObject` reference treats `guide.effort.durationMinutes` as duration evidence).
 *
 * Students encounter the regions in this order: what to read and look for, why it matters, expected effort, and the
 * question that checks whether the central idea can be retrieved.
 */
import type { NormalizedReference } from "~/lib/bibliography";
import {
    type LessonReadingGuide as LessonReadingGuideModel,
    readingFormat,
} from "~/lib/readings/lesson-readings-contract";
import { resolveReadingEffort } from "~/lib/readings/reading-effort";
import { formatReadingEffort } from "./format-reading-effort";

interface Props {
    guide: LessonReadingGuideModel;
    reference: NormalizedReference;
}

const { guide, reference } = Astro.props;
const format = readingFormat(reference.type);
const effort = formatReadingEffort(resolveReadingEffort(guide, reference.type));

type SecondaryField = { label: string; value: string };

// `role` (the current lesson-role taxonomy) takes precedence over the legacy `type` field; a guide with
// neither omits this field entirely rather than rendering an empty one.
const roleField: SecondaryField | null = guide.role
    ? { label: "Rol en esta lección", value: guide.role }
    : guide.type
    ? { label: "Tipo", value: guide.type }
    : null;

// Rendered below as a single "·"-joined line (e.g. "Intermedia · ≈ 15 min · Libro") rather than separate
// dt/dd rows, since these are secondary, at-a-glance metadata compared to the guidance above.
const secondaryFields: SecondaryField[] = [
    { label: "Formato", value: format },
    roleField,
    { label: "Dificultad", value: guide.difficulty },
    { label: "Esfuerzo estimado", value: effort },
].filter((field): field is SecondaryField => field !== null);
---

<div class="mt-4 text-sm text-base-subtle-text">
    <div data-reading-guidance>
        {
            guide.purpose && (
                <p class="mb-3 font-semibold text-base-text">
                    {guide.purpose}
                </p>
            )
        }
        <dl class="space-y-3">
            <div>
                <dt class="font-semibold text-base-text">Qué leer</dt>
                <dd class="mt-1 text-base-text">{guide.whatToRead}</dd>
            </div>
            <div>
                <dt class="font-semibold text-base-text">Qué buscar</dt>
                <dd class="mt-1 text-base-text">{guide.focus}</dd>
            </div>
            <div class="text-base-subtle-text">
                <dt class="font-semibold text-base-text">Por qué</dt>
                <dd class="mt-1">{guide.why}</dd>
            </div>
        </dl>
    </div>

    <p data-reading-metadata class="mt-4 flex flex-wrap items-center gap-x-2 text-xs">
        {
            secondaryFields.map((field, index) => (
                <>
                    {index > 0 && <span aria-hidden="true">·</span>}
                    <span>
                        <span class="sr-only">{field.label}: </span>
                        {field.value}
                    </span>
                </>
            ))
        }
    </p>

    <div data-reading-guide-question class="reading-guide-question mt-4">
        <p class="font-semibold text-base-text">Comprueba tu comprensión</p>
        <p>{guide.guidingQuestion}</p>
    </div>
</div>

<style scoped>
    /*
     * The guiding question is a retrieval task, not another descriptive field: it gets a light
     * question-accent treatment (reusing the shared "question" callout token) so it reads as
     * distinct from the `<dl>` above it, without introducing a full callout section/heading.
     */
    .reading-guide-question {
        border-inline-start: 3px solid var(--callout-accent-purple);
        background-color: color-mix(in srgb, var(--callout-accent-purple) 6%, transparent);
        padding-block: 0.5rem;
        padding-inline-start: 0.75rem;
    }
</style>
