---
import type { NormalizedReference } from "~/lib/bibliography";
import type { LessonReadingGuide as LessonReadingGuideModel } from "~/lib/readings/lesson-readings-contract";
import LessonReadingGuide from "./LessonReadingGuide.astro";
import ReferenceEntry from "./ReferenceEntry.astro";

interface Props {
    reference: NormalizedReference;
    reading: LessonReadingGuideModel;
    compact?: boolean;
}

const { reference, reading, compact = false } = Astro.props;
---

<ReferenceEntry {reference} preparedSlots={{}}>
    <Fragment slot="editorial"><LessonReadingGuide guide={reading} {compact} /></Fragment>
</ReferenceEntry>
