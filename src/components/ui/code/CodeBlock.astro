---
import type { ShikiTransformer } from "shiki";
import CodeLayout, { type CodeProps } from "./CodeLayout.astro";

type CodeBlockProps = {
    filename?: string;
    transformers?: ShikiTransformer[];
    compact?: boolean;
} & CodeProps;

const {
    code,
    lang = "text",
    class: className = "",
    title,
    filename,
    icon: Icon,
    titleClasses,
    transformers = [],
    compact = false,
} = Astro.props as CodeBlockProps;

const classes = ["bg-surface-50", "dark:bg-surface-800"];

// Build aria-label if we have a title or filename
let ariaLabel = "";
if (title) {
    ariaLabel = title + (filename ? ` – ${filename}` : "");
} else if (filename) {
    ariaLabel = filename;
}
---

<CodeLayout
    class:list={[...classes, className]} icon={Icon}
    {compact} source={filename}
    {code} {lang}
    {titleClasses}
    {transformers} {...ariaLabel ? { "aria-label": ariaLabel } : {}}
    {...title ? { title } : {}}
>
    {
        Astro.slots.title && (
            <Fragment slot="title">
                <slot name="title" />
            </Fragment>
        )
    }
    {
        Astro.slots.source && (
            <Fragment slot="source">
                <slot name="source" />
            </Fragment>
        )
    }
    {
        Astro.slots.footer && (
            <Fragment slot="footer">
                <slot name="footer" />
            </Fragment>
        )
    }
</CodeLayout>
