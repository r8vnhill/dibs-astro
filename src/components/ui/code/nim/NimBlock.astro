---
import * as icons from "$icons";
import CodeBlock from "../CodeBlock.astro";

type Props = {
    code: string;
    title?: string;
    compact?: boolean;
};

const { code, title, compact = false }: Props = Astro.props;
---

<CodeBlock
    lang="nim" icon={icons.Code}
    {code} {title}
    {compact}
>
    <Fragment slot="title">
        <slot name="title" />
    </Fragment>
    <Fragment slot="source">
        <slot name="source" />
    </Fragment>
    <Fragment slot="footer">
        <slot name="footer" />
    </Fragment>
</CodeBlock>
