---
import * as icons from "$icons";
import CodeBlock from "../CodeBlock.astro";

type Props = {
    code: string;
    title?: string;
};

const { code, title }: Props = Astro.props;
---

<CodeBlock
    lang="c" icon={icons.Kotlin}
    {code} {title}
>
    <Fragment slot="title">
        <slot name="title" />
    </Fragment>
    <Fragment slot="source">
        <slot name="source" />
    </Fragment>
</CodeBlock>
