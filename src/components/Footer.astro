---
/**
 * Displays author attribution and build tool credit at the bottom of a page.
 */

import { SiteFooter } from "@ravenhill/astro-site-chrome";
import { site } from "~/utils";

interface FooterProps {
    year?: number;
    author?: { name: string; url: string };
    builtWith?: { name: string; url: string };
}

// Destructure props with default fallbacks
const {
    year = new Date().getFullYear(),
    author = site.COPYRIGHT_HOLDER,
    builtWith = { name: "Astro", url: "https://astro.build" },
} = Astro.props as FooterProps;
const isPdfExport = Astro.locals.lessonRenderMode === "pdf";
const exportHiddenAttributes = isPdfExport ? { "data-export-hidden": "true" } : {};
const footerAttributes = {
    ...exportHiddenAttributes,
    role: "contentinfo",
    class: [
        "mt-12",
        "border-t",
        "border-base-border",
        "text-sm",
        "text-base-subtle",
        "py-8",
        "px-4",
        "text-center",
    ],
};
const contentAttributes = { class: "space-y-2" };
---

<SiteFooter {footerAttributes} {contentAttributes}>
        <p class="mt-2">
            © {year}{" "}
            <a
                href={author.url} aria-label={`Sitio de ${author.name}`}
                target="_blank" rel="noopener noreferrer"
                class="link-style"
            >
                {author.name}
            </a>.
        </p>
        <p>
            Hecho con{" "}
            <a
                href={builtWith.url} target="_blank"
                rel="noopener noreferrer" class="link-style"
            >
                {builtWith.name}
            </a>.
        </p>
        <p>
            Íconos del sitio proporcionados por{" "}
            <a
                href="https://gitlab.com/r8vnhill/astro-icons" target="_blank"
                rel="noopener noreferrer" class="link-style"
            >
                @ravenhill/astro-icons
            </a>, que reúne iconos de distintas fuentes, entre ellas{" "}
            <a
                href="https://phosphoricons.com/" target="_blank"
                rel="noopener noreferrer" class="link-style"
            >
                Phosphor Icons
            </a>{" "}y{" "}
            <a
                href="https://simpleicons.org/" target="_blank"
                rel="noopener noreferrer" class="link-style"
            >
                Simple Icons
            </a>, bajo sus respectivas licencias.
        </p>
</SiteFooter>
