---
/**
 * Header component for the site.
 *
 * Displays the themed DIBS logo, main navigation, a theme switcher, and optional links to GitLab and
 * GitHub repositories.
 *
 * @property title - The site title displayed as a link to the homepage.
 * @property gitlab - Optional GitLab username and repo.
 * @property github - Optional GitHub username and repo.
 */

import ThemeSwitcher from "$components/ui/theme/ThemeSwitcher";
import { m } from "~/generated/i18n/messages";
import type { LocalizedString } from "~/generated/i18n/messages";
import { site } from "~/utils";
import GitHubLink from "./GitHubLink.astro";
import GitLabLink from "./GitLabLink.astro";
import HeaderNav from "./nav/HeaderNav";

type Props = {
    title: string;
    gitlab?: { username: string; repo: string };
    github?: { username: string; repo: string };
    themeLabels: {
        current: LocalizedString;
        change: LocalizedString;
        light: LocalizedString;
        dark: LocalizedString;
        auto: LocalizedString;
    };
};

const { title, gitlab, github, themeLabels } = Astro.props as Props;
const isPdfExport = Astro.locals.lessonRenderMode === "pdf";
const exportHiddenAttributes = isPdfExport ? { "data-export-hidden": "true" } : {};
const navItems = [
    { id: "home", href: "/", label: m.nav_home() },
    { id: "notes", href: "/notes/", label: m.nav_notes() },
    { id: "lessons", href: "/lessons/", label: m.nav_lessons() },
    { id: "syllabus", href: "/syllabus/", label: m.nav_syllabus() },
    { id: "assignments", href: "/assignments/", label: m.nav_assignments() },
];
---

<!-- Header with themed background, border, and shadow -->
<header
    {...exportHiddenAttributes}
    class:list={[
        "fixed",
        "top-0",
        "inset-x-0",
        "z-50",
        "border-b",
        "shadow",
        "text-header-text",
        "bg-header-fill",
        "border-header-border",
    ]}
>
    <!-- Main navigation container -->
    <nav
        class:list={[
            "container", // Responsive container
            "mx-auto", // Center horizontally
            "flex", // Flexbox layout
            "items-center", // Vertically align items
            "justify-between", // Space between left and right sections
            "px-4", // Horizontal padding (mobile)
            "py-3", // Vertical padding
            "sm:px-8", // More padding on larger screens
        ]}
        role="navigation"
        aria-label="Navegación principal"
    >
        <!-- Left section: title and nav links -->
        <div class:list={["flex", "items-center", "gap-6"]}>
            <!-- Site logo linking to homepage -->
            <a
                href="/" class="inline-flex items-center"
                aria-label={m.header_home_aria()}
            >
                <span class="sr-only">{m.header_home_aria()}</span>
                <img
                    src={site.HEAD.LOGO_LIGHT_PATH} alt={title}
                    class="h-8 w-auto dark:hidden"
                />
                <img
                    src={site.HEAD.LOGO_DARK_PATH} alt=""
                    aria-hidden="true" class="hidden h-8 w-auto dark:block"
                />
            </a>

            <!-- Main navigation component -->
            <HeaderNav items={navItems} />
        </div>

        <!-- Right section: theme switcher and repository links -->
        <div class:list={["flex", "items-center", "gap-4"]}>
            <!-- Dark/light mode toggle -->
            <ThemeSwitcher client:load labels={themeLabels} />

            <!-- GitLab repository link (optional) -->
            {gitlab && <GitLabLink {...gitlab} />}

            <!-- GitHub repository link (optional) -->
            {github && <GitHubLink {...github} />}
        </div>
    </nav>
</header>
