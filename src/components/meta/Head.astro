---
/**
 * DIBS metadata adapter over `@ravenhill/astro-head`.
 *
 * The package owns generic page metadata: canonical URLs, social cards, citation fields, and
 * article JSON-LD. DIBS keeps application policy here, including branding links, fonts, sitemap,
 * locale-profile mapping, and the compatibility mapping from `lastModified` to both date fields.
 */
import {
    Head as GenericHead,
    type AcademicMetadataOptions,
    type HeadProps,
    type MetadataAuthor,
    type PageMetadata,
} from "@ravenhill/astro-head";
import { getLocaleProfile } from "$presentation/i18n/locale-profile";
import { site } from "~/utils";
import type { PageMeta } from "~/utils/page-meta";

interface Props {
    title?: string;
    description?: string;
    url?: string;
    type?: "website" | "article";
    pageMeta?: PageMeta;
    include404Font?: boolean;
}

const {
    title = site.SHORT_TITLE,
    description = site.LONG_TITLE,
    url = "https://dibs.ravenhill.cl",
    type = "website",
    pageMeta,
    include404Font = false,
} = Astro.props as Props;

const language = pageMeta?.language?.trim() || "es";
const localeProfile = getLocaleProfile(language);
const lastModified = pageMeta?.lastModified?.trim();
const baseFontStylesheet = "https://fonts.googleapis.com/css2?"
    + "family=Fira+Code&family=Inter:ital,wght@0,400..700;1,400..700"
    + "&family=Space+Grotesk:ital,wght@0,400..700;1,400..700&display=swap";
const authors: MetadataAuthor[] = (pageMeta?.authors ?? []).map(({ name, url: authorUrl }) => ({
    name,
    ...(authorUrl !== undefined ? { url: authorUrl } : {}),
}));

const page: PageMetadata = {
    title,
    description,
    url,
    language,
    type: pageMeta?.type ?? type,
    openGraphLocale: localeProfile.openGraphLocale,
    ...(pageMeta?.canonicalUrl !== undefined ? { canonicalUrl: pageMeta.canonicalUrl } : {}),
    ...(authors.length > 0 ? { authors } : {}),
    ...(lastModified
        ? { publishedAt: lastModified, modifiedAt: lastModified }
        : {}),
};

const academic: AcademicMetadataOptions = {
    highwire: true,
    dublinCore: true,
    jsonLd: true,
};

const headProps: HeadProps = {
    site: {
        name: site.SHORT_TITLE,
        socialImage: site.HEAD.DEFAULT_SOCIAL_IMAGE,
    },
    page,
    social: { image: site.HEAD.DEFAULT_SOCIAL_IMAGE },
    academic,
};
---

<GenericHead {...headProps} />

<link rel="icon" href={site.HEAD.FAVICON_PATH} type="image/png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link
    rel="stylesheet"
    href={baseFontStylesheet}
/>

<link rel="sitemap" href={site.HEAD.SITEMAP_PATH} />

{include404Font && (
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
)}
