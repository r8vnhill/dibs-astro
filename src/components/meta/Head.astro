---
/**
 * DIBS metadata adapter over `@ravenhill/astro-head`.
 *
 * The package owns generic page metadata: canonical URLs, social cards, citation fields, and
 * article JSON-LD. DIBS keeps application policy here, including branding links, fonts, sitemap,
 * locale-profile mapping, and application-owned font, favicon, and sitemap policy.
 */
import { getLocaleProfile } from "$presentation/i18n/locale-profile";
import {
  type AcademicMetadataOptions,
  Head as GenericHead,
  type HeadProps,
} from "@ravenhill/astro-head";
import { productionFontStylesheetUrl } from "~/lib/typography/production-font-stylesheet";
import { site } from "~/utils";
import { toDibsPageMetadata } from "~/utils/dibs-page-metadata";
import type { PageMeta } from "~/utils/page-meta";
import { buildDibsHeadLinks } from "./dibs-head-links";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  type?: "website" | "article";
  pageMeta?: PageMeta;
  include404Font?: boolean;
}

const {
  title = site.SHORT_TITLE,
  description = site.LONG_TITLE,
  url = "https://dibs.ravenhill.cl",
  type = "website",
  pageMeta,
  include404Font = false,
} = Astro.props as Props;

const language = pageMeta?.language?.trim() || "es";
const localeProfile = getLocaleProfile(language);
const page = toDibsPageMetadata({
  title,
  description,
  url,
  type,
  openGraphLocale: localeProfile.openGraphLocale,
  ...(pageMeta ? { pageMeta } : {}),
});

const academic: AcademicMetadataOptions = {
  highwire: true,
  dublinCore: true,
  jsonLd: true,
};

const headProps: HeadProps = {
  site: {
    name: site.SHORT_TITLE,
    socialImage: site.HEAD.DEFAULT_SOCIAL_IMAGE,
  },
  page,
  social: { image: site.HEAD.DEFAULT_SOCIAL_IMAGE },
  academic,
  links: buildDibsHeadLinks({
    faviconHref: site.HEAD.FAVICON_PATH,
    baseFontStylesheet: productionFontStylesheetUrl,
  }),
};
---

<GenericHead {...headProps} />

<link rel="sitemap" href={site.HEAD.SITEMAP_PATH} />

{
  include404Font && (
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet"
    />
  )
}
