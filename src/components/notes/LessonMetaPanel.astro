---
/**
 * @file LessonMetaPanel.astro
 *
 * Renders structured metadata for a lesson page.
 *
 * This component is responsible for displaying:
 *
 * - Authorship information.
 * - Last modification date.
 * - A short list of recent changes (limited to the most recent 3).
 * - Optional commit links to the website repository across one or more platforms.
 *
 * ## Design Goals
 *
 * - Keep all data shaping in the frontmatter script section.
 * - Keep markup declarative and presentation-focused.
 * - Avoid hard-coded repository URLs inside the template.
 * - Gracefully handle untrusted `platforms` input.
 *
 * ## Responsibilities
 *
 * - Normalizes platform selection using {@link normalizePlatforms}.
 * - Builds commit URLs using {@link buildCommitUrl}.
 * - Formats ISO dates using {@link formatLessonDate}.
 * - Filters out unavailable platforms from {@link websiteRepoRefs}.
 */

import {
    buildLessonMetaPanelViewModel,
    type LessonMetaPanelMetadata,
} from "$presentation/adapters/lesson-metadata-panel";
import { getWebsiteRepoRefs } from "$presentation/adapters/site-data";
import { type RepoPlatform, type RepoRef } from "@ravenhill/site-core";
import ReadingTime from "~/components/reading-time/ReadingTime.astro";
import type { PartialRecord } from "~/types/records";
import { Mono } from "../ui/font";
import { Link } from "../ui/links";

interface Props {
    /**
     * Parsed lesson metadata for the current page.
     */
    metadata?: LessonMetaPanelMetadata | undefined;

    /**
     * Compact reading-time estimate shown alongside the lesson provenance metadata.
     */
    readingTimeMinutes?: number | undefined;

    /**
     * Optional override for repository references used to build commit links.
     *
     * Allows:
     * - Testing with custom repos.
     * - Multi-site reuse.
     */
    websiteRepoRefs?: PartialRecord<RepoPlatform, RepoRef>;

    /**
     * Optional platform selection.
     *
     * May be:
     * - Undefined
     * - Invalid
     * - Duplicated
     * - Mixed with unsupported values
     *
     * Normalized through {@link normalizePlatforms}.
     */
    platforms?: unknown;
}

const {
    metadata,
    readingTimeMinutes,
    websiteRepoRefs = getWebsiteRepoRefs(),
    platforms,
} = Astro.props as Props;

const { authorsText, lastModified, recentChanges } = metadata
    ? buildLessonMetaPanelViewModel({ metadata, websiteRepoRefs, platforms })
    : { authorsText: "", lastModified: "", recentChanges: [] };

const sectionHeadingId = "lesson-meta-heading";
const recentChangesHeadingId = "lesson-meta-recent-changes-heading";
---

<section
    data-testid="lesson-metadata-panel" aria-labelledby={sectionHeadingId}
    class:list={[
        "border-l-2",
        "px-3",
        "py-1",
        "text-sm",
        "text-base-subtle-text",
        "border-primary/50",
        "mt-2",
    ]}
>
    <h2
        id={sectionHeadingId} class="sr-only"
        data-testid="panel-title"
    >
        Metadatos de la lección
    </h2>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        {readingTimeMinutes !== undefined && <ReadingTime minutes={readingTimeMinutes} />}

        {
            metadata && authorsText && (
                <>
                    {readingTimeMinutes !== undefined && <span aria-hidden="true">·</span>}
                    <span data-testid="authors-value">{authorsText}</span>
                </>
            )
        }

        {
            metadata && (
                <>
                    {(readingTimeMinutes !== undefined || Boolean(authorsText)) && <span aria-hidden="true">·</span>}
                    <span>Actualizado <time data-testid="last-updated-value">{lastModified}</time></span>
                    <span aria-hidden="true">·</span>
                    <details class="relative">
                        <summary class="cursor-pointer font-medium text-base-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            Historial de cambios
                        </summary>
                        <div class="mt-2 min-w-[min(100%,24rem)]">
                            <h3 id={recentChangesHeadingId} class="sr-only">Cambios recientes</h3>

                            {
                                recentChanges.length > 0 ? (
                                    <ul class="list-disc list-inside" data-testid="changes-list">
                                        {
                                            recentChanges.map((change) => (
                                                <li>
                                                    <Mono>{change.shortHash}</Mono>
                                                    {" · "}
                                                    {change.formattedDate}
                                                    {" · "}
                                                    {change.subject}
                                                    {
                                                        change.links.length > 0 && (
                                                            <span class="ml-1">
                                                                (
                                                                {
                                                                    change.links.map(
                                                                        (link, index) => (
                                                                        <Fragment>
                                                                            {index > 0 && " / "}
                                                                            <Link href={link.href}>{link.label}</Link>
                                                                        </Fragment>
                                                                    ),
                                                                    )
                                                                }
                                                                )
                                                            </span>
                                                        )
                                                    }
                                                </li>
                                            ))
                                        }
                                    </ul>
                                ) : (
                                    <p data-testid="changes-empty">
                                        No hay cambios registrados.
                                    </p>
                                )
                            }
                        </div>
                    </details>
                </>
            )
        }
    </div>
</section>
